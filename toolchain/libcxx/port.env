# LLVM's C++ runtimes against mlibc (docs/mlibc.md, "C++"): libc++,
# libc++abi and libunwind, static, with exceptions and RTTI, in
# target/libcxx-<arch> for the C++ ports to compile and link with
# (myos_libcxx_cxxflags, myos_libcxx_link). Nothing of it is in the image;
# its smoke, /bin/etc/mlibc/cxx_smoke, is the tests module's
# (docs/testing.md).
PORT_NAME=libcxx
PORT_DEPS=mlibc
PORT_BUILD=build.sh
PORT_OUTPUTS="libcxx-{arch} cxx-smoke-mlibc-{none}"
PORT_READY="libcxx-{arch}/lib/libc++.a"
PORT_TEST_FILES="bin:cxx-smoke-mlibc-{none}:bin/etc/mlibc/cxx_smoke"
PORT_TEST=test.sh
