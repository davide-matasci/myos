# The Rust std sysroot (target/myos-sysroot): precompiled std for the
# *-unknown-myos targets, a build dependency of the Rust ports (PORT_DEPS
# "sysroot": coreutils, ripgrep, std-hello). Nothing of it is in the image.
# fetch-sysroot.sh takes it from the registry, a tarball, or builds it
# (slow); CI has a dedicated job (ci-sysroot-job.sh) and caches the slim
# pack below. The stamp lives inside the sysroot.
PORT_NAME=sysroot
PORT_KIND=toolchain
PORT_BUILD=fetch-sysroot.sh
PORT_STAMP="myos-sysroot/.myos-sysroot-version"
PORT_OUTPUTS="myos-sysroot/myos-manifest.toml myos-sysroot/lib/rustlib/{myos} myos-sysroot/lib/rustlib/{myos}.json"
PORT_READY="myos-sysroot/.myos-sysroot-version"
PORT_FILES=""
