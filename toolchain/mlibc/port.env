# mlibc (managarm/mlibc), the second C library (docs/mlibc.md): libc.a, the
# crt objects and the headers for the three arches, in target/mlibc-<arch>,
# over the C both libcs share (toolchain/libmyos) and the sysdeps here.
# Programs opt in per port (PORT_LIBC=mlibc); newlib stays the default. Its
# programs are static, but for the ones that opt into shared objects
# (docs/mlibc.md "Shared objects"): for those the image carries the dynamic
# linker and the shared libc in /lib (shared/: ld.so, libc.so and the
# empty libm.so and its like, the names a link's -lm leaves in DT_NEEDED).
PORT_NAME=mlibc
# A library: the ports over it key on its headers and its symbols, the
# programs on its archives (docs/ports.md "Cache keys").
PORT_LIBRARY=1
PORT_BUILD=build.sh
PORT_OUTPUTS="mlibc-{arch}"
# The last thing its build installs.
PORT_READY="mlibc-{arch}/shared/ld.so"
PORT_FILES="data:mlibc-{arch}/shared/ld.so:lib/ld.so data:mlibc-{arch}/shared/libc.so:lib/libc.so data:mlibc-{arch}/shared/libm.so:lib/libm.so data:mlibc-{arch}/shared/libpthread.so:lib/libpthread.so data:mlibc-{arch}/shared/libdl.so:lib/libdl.so data:mlibc-{arch}/shared/librt.so:lib/librt.so data:mlibc-{arch}/shared/libutil.so:lib/libutil.so data:mlibc-{arch}/shared/libresolv.so:lib/libresolv.so"
