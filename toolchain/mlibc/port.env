# mlibc (managarm/mlibc), the second C library (docs/mlibc.md): libc.a, the
# crt objects and the headers for the three arches, in target/mlibc-<arch>,
# over the C both libcs share (toolchain/libmyos) and the sysdeps here.
# Programs opt in per port (PORT_LIBC=mlibc); newlib stays the default. The
# image carries its sysroot tree at /lib/mlibc, as newlib's at /lib/newlib.
PORT_NAME=mlibc
PORT_BUILD=build.sh
PORT_OUTPUTS="mlibc-{arch}"
PORT_READY="mlibc-{arch}/lib/libc.a"
PORT_FILES="tree:mlibc-{arch}/include:lib/mlibc/include tree:mlibc-{arch}/lib:lib/mlibc/lib"
