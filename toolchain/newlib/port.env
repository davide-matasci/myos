# newlib + libgloss/myos: the C library every C port links against, and the
# sysroot tree the image ships for tcc (/lib/newlib/include, /lib/newlib/lib;
# tcc's build installs libtcc1.a into the same tree). Built first: a
# toolchain, not a program (its own CI job, pulled by every ports job).
PORT_KIND=toolchain
PORT_CORE=1
PORT_BUILD=build.sh
PORT_OUTPUTS="newlib-bin newlib-{arch}"
PORT_READY="newlib-{arch}/{myos}/lib/libc.a"
PORT_FILES="tree:newlib-{arch}/{myos}/include:lib/newlib/include tree:newlib-{arch}/{myos}/lib:lib/newlib/lib"
