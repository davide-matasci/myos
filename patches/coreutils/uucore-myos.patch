+/// Build a [`PathBuf`] without `PathBuf::from(OsString)` (myos aborts with exit 101).
+fn path_from_name(name: &str) -> PathBuf {
+    PathBuf::from(name)
+}
+
+fn path_from_osstring(s: &OsString) -> PathBuf {
+    path_from_name(s.to_str().unwrap_or("coreutils"))
+}
