+static void
+j_apply_wait(int pid, int status)
+{
+	Job	*j;
+	Proc	*p = NULL;
+
+	for (j = job_list; j != NULL; j = j->next)
+		for (p = j->proc_list; p != NULL; p = p->next)
+			if (p->pid == pid)
+				goto found;
+found:
+	if (j == NULL)
+		return;
+	p->status = status;
+	if (WIFSTOPPED(status))
+		p->state = PSTOPPED;
+	else if (WIFSIGNALED(status))
+		p->state = PSIGNALLED;
+	else
+		p->state = PEXITED;
+	check_job(j);
+}
