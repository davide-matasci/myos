+    /// `Match (SearchPkg, MatchOp1, Operand1, MatchOp2, Operand2, StartIndex)`, in three stages:
+    /// the package, then the first opcode byte and its operand, then the second and its operand
+    /// and the start index. The result is the index of the first element from `StartIndex` for
+    /// which both comparisons hold (the element on the left), or Ones.
+    fn do_match(&self, context: &mut MethodContext, op: OpInFlight) -> Result<(), AmlError> {
+        const STAGE_2: &[ResolveBehaviour] =
+            &[ResolveBehaviour::Placeholder, ResolveBehaviour::Placeholder, ResolveBehaviour::TermArg];
+        const STAGE_3: &[ResolveBehaviour] = &[
+            ResolveBehaviour::Placeholder,
+            ResolveBehaviour::Placeholder,
+            ResolveBehaviour::Placeholder,
+            ResolveBehaviour::Placeholder,
+            ResolveBehaviour::TermArg,
+            ResolveBehaviour::TermArg,
+        ];
+        match op.arguments.len() {
+            1 => {
+                let first = context.next()?;
+                let mut arguments = op.arguments;
+                arguments.push(Argument::ByteData(first));
+                context.start(OpInFlight::new_with(Opcode::Match, arguments, STAGE_2));
+                return Ok(());
+            }
+            3 => {
+                let second = context.next()?;
+                let mut arguments = op.arguments;
+                arguments.push(Argument::ByteData(second));
+                context.start(OpInFlight::new_with(Opcode::Match, arguments, STAGE_3));
+                return Ok(());
+            }
+            _ => (),
+        }
+        let [
+            Argument::Object(package),
+            Argument::ByteData(op1),
+            Argument::Object(operand1),
+            Argument::ByteData(op2),
+            Argument::Object(operand2),
+            Argument::Object(start),
+        ] = &op.arguments[..]
+        else {
+            panic!()
+        };
+        let package = package.clone().unwrap_transparent_reference();
+        let Object::Package(ref elements) = *package else {
+            Err(AmlError::ObjectNotOfExpectedType { expected: ObjectType::Package, got: package.typ() })?
+        };
+        let operand1 = operand1.clone().unwrap_transparent_reference();
+        let operand2 = operand2.clone().unwrap_transparent_reference();
+        let start = start.clone().unwrap_transparent_reference().as_integer()? as usize;
+
+        /*
+         * One comparison of an element with an operand (MTR, MEQ, MLE, MLT, MGE, MGT). The operand
+         * takes the element's type; an element that is not an integer, a string or a buffer, or an
+         * operand that cannot be converted, does not match.
+         */
+        fn holds(element: &Object, op: u8, operand: &Object) -> bool {
+            use core::cmp::Ordering;
+            let ordering = match element {
+                Object::Integer(e) => match operand.as_integer() {
+                    Ok(o) => e.cmp(&o),
+                    Err(_) => return false,
+                },
+                Object::String(e) => match operand.as_string() {
+                    Ok(o) => e.as_str().cmp(&*o),
+                    Err(_) => return false,
+                },
+                Object::Buffer(e) => match operand.as_buffer() {
+                    Ok(o) => e.as_slice().cmp(o),
+                    Err(_) => return false,
+                },
+                _ => return false,
+            };
+            match op {
+                0 => true,
+                1 => ordering == Ordering::Equal,
+                2 => ordering != Ordering::Greater,
+                3 => ordering == Ordering::Less,
+                4 => ordering != Ordering::Less,
+                5 => ordering == Ordering::Greater,
+                _ => false,
+            }
+        }
+
+        let found = elements
+            .iter()
+            .enumerate()
+            .skip(start)
+            .find(|(_, element)| {
+                let element = (*element).clone().unwrap_transparent_reference();
+                holds(&element, *op1, &operand1) && holds(&element, *op2, &operand2)
+            })
+            .map_or(u64::MAX, |(i, _)| i as u64);
+        context.contribute_arg(Argument::Object(Object::Integer(found).wrap()));
+        context.retire_op(op);
+        Ok(())
+    }
 
