# Boot CI curated udp suite — suite-prefixed paths (suite/rel, no .c): the
# UDP stack over netd's loopback interface (bind, connect and unconnect,
# getsockname/getpeername, sendto/recvfrom, shutdown, poll, SO_ERROR and
# the ECONNREFUSED an ICMP "port unreachable" gives a connected socket),
# and its interface with the LAN address (getifaddrs). Every entry passes
# on bios, aarch64 and riscv64.

TESTS += udp/accept-nonblock
TESTS += udp/accept
TESTS += udp/bind-any-0-getpeername
TESTS += udp/bind-any-0-getsockname
TESTS += udp/bind-any-0-unbind
TESTS += udp/bind-any-0
