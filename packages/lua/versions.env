# Pin for Lua (fetched at build; not vendored).
LUA_VERSION=5.4.7
# lua.org, then Debian's copy of the same tarball (`orig.tar.gz`, the sha256
# below too): www.lua.org refused connections for minutes (PR #765's port job).
LUA_URLS="https://www.lua.org/ftp/lua-${LUA_VERSION}.tar.gz https://deb.debian.org/debian/pool/main/l/lua5.4/lua5.4_${LUA_VERSION}.orig.tar.gz"
# Official lua.org ftp tarball SHA-256.
LUA_SHA256=9fbf5e28ef86c69858f6d3d34eccc32e911c1a28b4120ff3e84aaa70cfbf1e30
