# Pin for Lua (fetched at build; not vendored).
LUA_VERSION=5.4.7
# Where the tarball comes from, first that answers: lua.org, then two
# copies of the same file kept elsewhere (Debian's orig tarball, MacPorts'
# distfiles), for when lua.org is down.
LUA_URLS="https://www.lua.org/ftp/lua-${LUA_VERSION}.tar.gz
https://deb.debian.org/debian/pool/main/l/lua5.4/lua5.4_${LUA_VERSION}.orig.tar.gz
https://distfiles.macports.org/lua/lua-${LUA_VERSION}.tar.gz"
# Official lua.org ftp tarball SHA-256.
LUA_SHA256=9fbf5e28ef86c69858f6d3d34eccc32e911c1a28b4120ff3e84aaa70cfbf1e30
