# dwm, the window manager (keyboard driven: no mouse needed), on the X
# server of the tinyx package; and its boot test. It starts st and dmenu
# (its terminal and launcher keys), so its app needs them.
PORT_CORE=0
PORT_DEPS="x11-xft"
PORT_RDEPS="x11-xft x11-fonts st dmenu"
PORT_BUILD=build.sh
PORT_OUTPUTS="dwm-{none} dwm-smoke-{none}"
PORT_FILES="bin:dwm-{none}:bin/custom/dwm bin:dwm-smoke-{none}:bin/etc/dwm_smoke"
PORT_TEST=test.sh
