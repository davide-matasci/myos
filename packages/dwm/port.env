# dwm, the window manager (keyboard driven: no mouse needed), on the X
# server of the tinyx package; and its boot test.
PORT_CORE=0
PORT_DEPS="x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="dwm-{none} dwm-smoke-{none}"
PORT_FILES="bin:dwm-{none}:bin/custom/dwm bin:dwm-smoke-{none}:bin/etc/dwm_smoke"
PORT_TEST=test.sh
