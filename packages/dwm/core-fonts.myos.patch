+/* The text as the core font's 8-bit characters: UTF-8 decoded, code
+ * points past Latin-1 (and invalid sequences) as '?'. Returns its length. */
+static size_t
+latin1(const char *text, char *buf, size_t size)
+{
+	size_t n = 0;
+	long u;
+	int err;
+
+	while (*text && n < size) {
+		text += utf8decode(text, &u, &err);
+		buf[n++] = (err || u > 0xFF) ? '?' : (char)u;
+	}
+	return n;
+}
