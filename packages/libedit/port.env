# libedit (BSD line editing, with GNU readline's interface in
# editline/readline.h), against mlibc for python's readline module: build
# output only, nothing in the image.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc ncurses"
PORT_BUILD=build.sh
PORT_OUTPUTS="libedit-mlibc-{arch}"
PORT_READY="libedit-mlibc-{arch}/lib/libedit.a"
PORT_FILES=""
