# Pin for the one true awk (fetched at build; not vendored): a release is
# a date, the tag of https://github.com/onetrue-awk/awk and the version
# the program prints.
AWK_VERSION=2025-12-25
# Debian's copy of the release (`orig.tar.gz`, the sha256 below): a tarball
# that stays the same, where GitHub packs a tag's when it is asked for.
AWK_URLS="https://deb.debian.org/debian/pool/main/o/original-awk/original-awk_${AWK_VERSION}.orig.tar.gz"
AWK_SHA256=5eb8bb449848b2860ecff1fba09a0429853f849277c7e8fa2825ba4a553af920
