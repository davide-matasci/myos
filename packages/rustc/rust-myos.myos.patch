+++ b/compiler/rustc_target/src/spec/targets/aarch64_unknown_myos_mlibc.rs
@@ -0,0 +1,23 @@
+use crate::spec::{Arch, Target, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::myos_mlibc::opts();
+    base.features = "+v8a,+strict-align,+neon,+fp-armv8".into();
+    base.disable_redzone = true;
+    base.max_atomic_width = Some(128);
+
+    Target {
+        // A bare target for LLVM: myos is not one of its systems.
+        llvm_target: "aarch64-unknown-none".into(),
+        metadata: crate::spec::TargetMetadata {
+            description: Some("myos on mlibc (aarch64)".into()),
+            tier: Some(3),
+            host_tools: Some(true),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32".into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
