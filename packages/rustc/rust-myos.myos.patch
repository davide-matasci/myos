@@ -0,0 +1,38 @@
+//! myos on mlibc (`<arch>-unknown-myos-mlibc`): a unix target whose
+//! programs are static PIEs linked with lld against mlibc and LLVM's
+//! libunwind, or dynamic ones over mlibc's shared objects.
+
+use crate::spec::{
+    Cc, Env, LinkerFlavor, Lld, Os, PanicStrategy, StackProbeType, TargetOptions, cvs,
+};
+
+pub(crate) fn opts() -> TargetOptions {
+    // Given for the plain linker: its lld twin gets them too.
+    let pre_link_args = TargetOptions::link_args(
+        LinkerFlavor::Gnu(Cc::No, Lld::No),
+        &["-z", "max-page-size=4096", "--eh-frame-hdr"],
+    );
+    // The C library, the unwinder and the compiler builtins its code
+    // calls, from the directories the link is given (the sysroot's, or
+    // `-L`).
+    let late_link_args =
+        TargetOptions::link_args(LinkerFlavor::Gnu(Cc::No, Lld::No), &["-lunwind", "-lc", "-lbuiltins"]);
+    TargetOptions {
+        os: Os::Myos,
+        env: Env::Mlibc,
+        families: cvs!["unix"],
+        linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+        linker: Some("rust-lld".into()),
+        pre_link_args,
+        late_link_args,
+        dynamic_linking: true,
+        executables: true,
+        has_rpath: true,
+        position_independent_executables: true,
+        static_position_independent_executables: true,
+        plt_by_default: false,
+        panic_strategy: PanicStrategy::Unwind,
+        stack_probes: StackProbeType::Inline,
+        ..Default::default()
+    }
+}
