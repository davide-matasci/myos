# rustc: the Rust compiler and cargo with myos as their host
# (packages/rustc/README.md). The app is the compiler (/bin/custom/rustc
# over /lib/librustc_driver-*.so), cargo and the std of their own target,
# <arch>-unknown-myos-mlibc (/lib/rustlib). It links with the llvm app's
# lld against that app's mlibc and libunwind. Built an arch a job: one is
# an LLVM and two compilers.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx libressl"
PORT_RDEPS="llvm"
PORT_BUILD=build.sh
PORT_OUTPUTS="rustc-{arch}"
PORT_READY="rustc-{arch}/bin/rustc"
PORT_FILES="bin:rustc-{arch}/bin/rustc:bin/custom/rustc bin:rustc-{arch}/bin/cargo:bin/custom/cargo tree:rustc-{arch}/lib:lib"
PORT_TEST=test.sh
PORT_ARCH_JOBS=1
PORT_TIMEOUT=340
