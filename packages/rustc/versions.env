# The Rust compiler's source: the nightly rust-toolchain.toml pins (the
# one the myos std is built with), its source tarball from
# static.rust-lang.org (dist/<date>/rustc-nightly-src.tar.xz), with the
# compiler, cargo, the LLVM it is built on and every crate they need
# (vendor/). toolchain/std/bump-nightly.sh --write names this file: a
# bump needs RUST_SRC_SHA256 (the .sha256 beside the tarball) and the
# patches rebased (rust-myos.myos.patch, port-crates.py).
RUST_NIGHTLY=2026-07-26
RUST_SRC_SHA256=beedb24a04c94cbf2c4210e5c5e5438e4f6c0b8d9e652716c7a8df57c2798cac
