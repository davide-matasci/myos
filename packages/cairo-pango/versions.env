# Pins for the text and drawing libraries (fetched at build; not vendored):
# the release tarballs and their SHA-256 (cairo's from its .sha256sum,
# pango's, gdk-pixbuf's and libepoxy's from download.gnome.org's; harfbuzz
# and fribidi publish none beside their GitHub releases).
HARFBUZZ_VERSION=15.0.0
HARFBUZZ_URL=https://github.com/harfbuzz/harfbuzz/releases/download/${HARFBUZZ_VERSION}/harfbuzz-${HARFBUZZ_VERSION}.tar.xz
HARFBUZZ_SHA256=968536e9abd782f07f7954044c0c4020199fcdd39b41d221ec42d2a3be4a44df
FRIBIDI_VERSION=1.0.17
FRIBIDI_URL=https://github.com/fribidi/fribidi/releases/download/v${FRIBIDI_VERSION}/fribidi-${FRIBIDI_VERSION}.tar.xz
FRIBIDI_SHA256=6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2
CAIRO_VERSION=1.18.6
CAIRO_URL=https://cairographics.org/releases/cairo-${CAIRO_VERSION}.tar.xz
CAIRO_SHA256=1c767308174337a74694da0f3ec069c271452163a1ef4540964c50c301f157d4
# pango 1.56, the last series over fontconfig 2.15 (x11-xft's; 1.58 wants
# 2.17); GTK 3 needs 1.44.
PANGO_VERSION=1.56.4
PANGO_URL=https://download.gnome.org/sources/pango/1.56/pango-${PANGO_VERSION}.tar.xz
PANGO_SHA256=17065e2fcc5f5a5bdbffc884c956bfc7c451a96e8c4fb2f8ad837c6413cb5a01
GDK_PIXBUF_VERSION=2.44.8
GDK_PIXBUF_URL=https://download.gnome.org/sources/gdk-pixbuf/2.44/gdk-pixbuf-${GDK_PIXBUF_VERSION}.tar.xz
GDK_PIXBUF_SHA256=919f529512961a12e81cd4b4b466a48c3933469e7f9a310c6513cd4fb252ba3c
# libepoxy: GNOME's copy of the release (download.gnome.org), the same as
# the GitHub release's.
LIBEPOXY_VERSION=1.5.10
LIBEPOXY_URL=https://download.gnome.org/sources/libepoxy/1.5/libepoxy-${LIBEPOXY_VERSION}.tar.xz
LIBEPOXY_SHA256=072cda4b59dd098bba8c2363a6247299db1fa89411dc221c8b81b8ee8192e623
# The Khronos EGL headers (EGL-Registry's api/ at a commit, each file
# checked): libepoxy's EGL dispatch is built over them, and WebKitGTK
# (packages/webkitgtk) compiles against them. No EGL library: nothing
# loads one at run time.
EGL_REGISTRY_COMMIT=e964211ff5f7c2bcada786954a16d5b813379395
EGL_REGISTRY_URL=https://raw.githubusercontent.com/KhronosGroup/EGL-Registry/${EGL_REGISTRY_COMMIT}/api
EGL_HEADERS="EGL/egl.h:a7c24c828bf2e1a4dfe6511b4f4812b948a285eb54787074015896976d4da076
EGL/eglext.h:a5f574a0074001400c6c50232235ee00e9a67b2168bfd1c364ba0f6f52e5a75c
EGL/eglplatform.h:25b5391655effcf363a38fa00c3154f356a3eab3d35dc067847875513cf1e441
KHR/khrplatform.h:7b1e01aaa7ad8f6fc34b5c7bdf79ebf5189bb09e2c4d2e79fc5d350623d11e83"
