# The text and drawing libraries of GTK 3's stack against mlibc (fribidi,
# harfbuzz, cairo, pango, gdk-pixbuf, libepoxy), static, for GTK (issue
# #616): build output in target/cairo-pango-mlibc-<arch>. The app is the
# package's smoke (smoke.c, its test).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx glib image-libs x11-xft"
PORT_BUILD=build.sh
PORT_OUTPUTS="cairo-pango-mlibc-{arch} cairo-pango-smoke-mlibc-{none}"
PORT_READY="cairo-pango-mlibc-{arch}/lib/libpangocairo-1.0.a"
PORT_FILES="bin:cairo-pango-smoke-mlibc-{none}:bin/custom/cairo-pango-smoke"
PORT_TEST=test.sh
