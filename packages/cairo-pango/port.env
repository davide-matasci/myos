# The text and drawing libraries of GTK 3's stack against mlibc (fribidi,
# harfbuzz, cairo, pango, gdk-pixbuf, libepoxy), static, for GTK (issue
# #616): build output in target/cairo-pango-mlibc-<arch>. A library: no
# app; its smoke is the cairo-pango-smoke package's (docs/ports.md "Cache
# keys").
PORT_CORE=0
PORT_LIBC=mlibc
PORT_LIBRARY=1
PORT_DEPS="mlibc libcxx glib image-libs x11-xft"
PORT_BUILD=build.sh
PORT_OUTPUTS="cairo-pango-mlibc-{arch}"
PORT_READY="cairo-pango-mlibc-{arch}/lib/libpangocairo-1.0.a"
PORT_FILES=""
