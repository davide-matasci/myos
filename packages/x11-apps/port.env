# Small X applications on the X server of the tinyx package: xev, which
# prints the events a window (or the root) gets. Built with libXext and
# libXrandr on top of the font stack's libraries (packages/x11-xft).
PORT_CORE=0
PORT_DEPS="x11-xft"
PORT_RDEPS="x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="xev-{none}"
PORT_FILES="bin:xev-{none}:bin/custom/xev"
PORT_TEST=test.sh
