# Small X applications on the X server of the tinyx package: xev, which
# prints the events a window (or the root) gets, and xprop, which prints
# and sets a window's properties (surf's address bar sets its URL with it). Built on the font
# stack's libraries (packages/x11-xft, x11-libs' extensions among them).
PORT_CORE=0
PORT_DEPS="x11-xft"
PORT_RDEPS="x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="xev-{none} xprop-{none}"
PORT_FILES="bin:xev-{none}:bin/custom/xev bin:xprop-{none}:bin/custom/xprop"
PORT_TEST=test.sh
