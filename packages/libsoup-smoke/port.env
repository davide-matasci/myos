# The network libraries' smoke (packages/libsoup, docs/ports.md "Cache
# keys"), against mlibc: libsoup over HTTP and over HTTPS through
# glib-networking and LibreSSL, libxml2 and libpsl (smoke.c, the package's
# test). A package of its own, not libsoup's, so that a change to what it
# links and the libraries never compile against relinks it and rebuilds
# no library.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx zlib glib libressl sqlite libsoup"
PORT_BUILD=build.sh
PORT_OUTPUTS="libsoup-smoke-mlibc-{none}"
PORT_FILES="bin:libsoup-smoke-mlibc-{none}:bin/custom/libsoup-smoke"
PORT_TEST=test.sh
