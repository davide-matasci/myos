# GLib (GLib, GObject, GIO; with zlib, libffi, GNU libiconv and
# proxy-libintl), static against mlibc for WebKitGTK's stack (issue #616).
# The app is GIO's gio and the package's smoke (smoke.c, its test).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc zlib pcre2"
PORT_BUILD=build.sh
PORT_OUTPUTS="glib-mlibc-{arch} glib-smoke-mlibc-{none} gio-mlibc-{none} glib-host"
PORT_READY="glib-mlibc-{arch}/lib/libgio-2.0.a"
PORT_FILES="bin:gio-mlibc-{none}:bin/custom/gio bin:glib-smoke-mlibc-{none}:bin/custom/glib-smoke"
PORT_TEST=test.sh
