# GLib (GLib, GObject, GIO; with zlib, libffi, GNU libiconv and
# proxy-libintl), static against mlibc for WebKitGTK's stack (issue #616):
# build output in target/glib-mlibc-<arch> and the host's tools in
# target/glib-host. A library: no app; its programs, GIO's gio and the
# smoke, are the glib-tools package's (docs/ports.md "Cache keys").
PORT_CORE=0
PORT_LIBC=mlibc
PORT_LIBRARY=1
PORT_DEPS="mlibc zlib pcre2"
PORT_BUILD=build.sh
PORT_OUTPUTS="glib-mlibc-{arch} glib-host"
PORT_READY="glib-mlibc-{arch}/lib/libgio-2.0.a"
PORT_FILES=""
