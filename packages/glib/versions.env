# Pins for GLib and libffi (fetched at build; not vendored). zlib's and
# PCRE2's sources are the pins of ports/zlib and packages/pcre2.
# GLib: the release tarball and its SHA-256 (download.gnome.org's
# glib-<version>.sha256sum).
GLIB_VERSION=2.90.1
GLIB_URL=https://download.gnome.org/sources/glib/2.90/glib-${GLIB_VERSION}.tar.xz
GLIB_SHA256=93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396
# libffi: the release tarball (github.com/libffi/libffi/releases).
LIBFFI_VERSION=3.8.0
LIBFFI_URL=https://github.com/libffi/libffi/releases/download/v${LIBFFI_VERSION}/libffi-${LIBFFI_VERSION}.tar.gz
LIBFFI_SHA256=7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4
# proxy-libintl: GLib's libintl when the libc has none (mlibc): gettext
# that returns its message, a git tag checked against its commit.
PROXY_LIBINTL_VERSION=0.5
PROXY_LIBINTL_REV=33934de09af6a6627eb44e310a8079df009abdbb
# GNU libiconv: GLib's iconv (mlibc has none), the release tarball (its
# .sig checked against Bruno Haible's key in the GNU keyring).
LIBICONV_VERSION=1.19
LIBICONV_URL=https://ftp.gnu.org/pub/gnu/libiconv/libiconv-${LIBICONV_VERSION}.tar.gz
LIBICONV_SHA256=88dd96a8c0464eca144fc791ae60cd31cd8ee78321e67397e25fc095c4a19aa6
