# The text and drawing libraries' smoke (packages/cairo-pango, docs/ports.md
# "Cache keys"), against mlibc: fribidi, HarfBuzz, pango, cairo and
# gdk-pixbuf, and cairo's Xlib surface (smoke.c, the package's test). A
# package of its own, not cairo-pango's, so that a change to what it links
# and the libraries never compile against relinks it and rebuilds no
# library.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx zlib glib image-libs x11-xft cairo-pango"
PORT_BUILD=build.sh
PORT_OUTPUTS="cairo-pango-smoke-mlibc-{none}"
PORT_FILES="bin:cairo-pango-smoke-mlibc-{none}:bin/custom/cairo-pango-smoke"
PORT_TEST=test.sh
