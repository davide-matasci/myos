# GTK 3's smoke (packages/gtk3, docs/ports.md "Cache keys"), against mlibc:
# a GTK window on Xfbdev (smoke.c, the package's test). A package of its
# own, not gtk3's, so that a change to what it links and GTK never
# compiles against relinks it and rebuilds no library.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx zlib glib image-libs cairo-pango x11-xft gtk3"
PORT_BUILD=build.sh
PORT_OUTPUTS="gtk3-smoke-mlibc-{none}"
PORT_FILES="bin:gtk3-smoke-mlibc-{none}:bin/custom/gtk3-smoke"
PORT_TEST=test.sh
