# openssl(1): LibreSSL's command-line tool (keys, certificate requests and
# certificates, digests, base64, s_client, ...), built from the source the
# libressl port pins against that port's libraries. What acme does its
# cryptography with; /lib/ssl holds its default configuration.
PORT_CORE=0
PORT_DEPS="libressl"
PORT_BUILD=build.sh
PORT_OUTPUTS="openssl-{none} openssl-src/openssl.cnf openssl-src/x509v3.cnf"
PORT_FILES="bin:openssl-{none}:bin/custom/openssl data:openssl-src/openssl.cnf:lib/ssl/openssl.cnf data:openssl-src/x509v3.cnf:lib/ssl/x509v3.cnf"
PORT_TEST=test.sh
