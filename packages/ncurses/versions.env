# Pin for ncurses (fetched at build; not vendored).
# Stable 6.5 release (2024-04-27).
NCURSES_VERSION=6.5
NCURSES_TARBALL=ncurses-${NCURSES_VERSION}.tar.gz
# First that answers: GNU's redirector to a nearby mirror, a mirror outside
# GNU's own servers (they go down together), then ftp.gnu.org itself.
NCURSES_URLS="https://ftpmirror.gnu.org/gnu/ncurses/${NCURSES_TARBALL}
https://mirror.yandex.ru/mirrors/gnu/ncurses/${NCURSES_TARBALL}
https://ftp.gnu.org/gnu/ncurses/${NCURSES_TARBALL}"
# Official tarball SHA-256 (GNU ncurses 6.5).
NCURSES_SHA256=136d91bc269a9a5785e5f9e980bc76ab57428f604ce3e5a5a90cebc767971cc6
