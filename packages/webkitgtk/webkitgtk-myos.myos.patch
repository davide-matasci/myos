--- /dev/null
+++ b/Source/WebKit/myos/MultiCall.cpp
@@ -0,0 +1,49 @@
+/*
+ * myos: a program and WebKit's processes in one static binary (myos has
+ * no shared libraries). The UI process runs the program again with the
+ * process's name first (ProcessLauncherGLib.cpp); anything else is the
+ * program, whose main is webkit_myos_program_main. GIO's TLS backend
+ * (glib-networking's OpenSSL one, a module GIO would load) is registered
+ * first: a static program has no modules to load.
+ *
+ * Copyright (C) 2026 the myos authors
+ *
