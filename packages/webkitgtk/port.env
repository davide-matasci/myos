# WebKitGTK (the webkit2gtk-4.1 API) against mlibc, static, with ICU,
# libgpg-error, libgcrypt and libtasn1, toward surf (issue #616): build
# output in target/webkitgtk-mlibc-<arch>. The app is the package's
# program (smoke.c, its test): a browser window and WebKit's web and
# network processes in one binary.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx glib image-libs cairo-pango x11-xft gtk3 libsoup libressl sqlite"
PORT_BUILD=build.sh
PORT_OUTPUTS="webkitgtk-mlibc-{arch} webkitgtk-smoke-mlibc-{none}"
PORT_READY="webkitgtk-mlibc-{arch}/lib/libwebkit2gtk-4.1.a"
# ICU's data, a file of its own: the program opens it in /lib/webkitgtk.
PORT_FILES="bin:webkitgtk-smoke-mlibc-{none}:bin/custom/webkitgtk-smoke tree:webkitgtk-mlibc-{arch}/share/icu-data:lib/webkitgtk"
PORT_TEST=test.sh
# One CI job per arch (a WebKit build takes hours), each cached apart.
PORT_ARCH_JOBS=1
PORT_TIMEOUT=340
