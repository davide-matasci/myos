# WebKitGTK and the libraries it needs beyond the other packages' (issue
# #616), against mlibc: release tarballs, checked against their sha256.
ICU_VERSION=79.1
ICU_URL=https://github.com/unicode-org/icu/releases/download/release-${ICU_VERSION}/icu4c-${ICU_VERSION}-sources.tgz
ICU_SHA256=06fa63ecb521048f8082f12ad988f6b678d90cbd88aafce24cbc94902b191d99
LIBGPG_ERROR_VERSION=1.61
# gnupg.org refuses connections for minutes at a time (CI #2372, PR #685):
# Debian's pool keeps the same tarball (the pin's sha256 holds for both).
LIBGPG_ERROR_URL="https://gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-${LIBGPG_ERROR_VERSION}.tar.bz2 https://deb.debian.org/debian/pool/main/libg/libgpg-error/libgpg-error_${LIBGPG_ERROR_VERSION}.orig.tar.bz2"
LIBGPG_ERROR_SHA256=7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93
LIBGCRYPT_VERSION=1.12.4
LIBGCRYPT_URL="https://gnupg.org/ftp/gcrypt/libgcrypt/libgcrypt-${LIBGCRYPT_VERSION}.tar.bz2 https://deb.debian.org/debian/pool/main/libg/libgcrypt20/libgcrypt20_${LIBGCRYPT_VERSION}.orig.tar.bz2"
LIBGCRYPT_SHA256=d77f68f48879510e79a2f65977ccc68981781ea0923e5bdffac2a193ea3d660e
LIBTASN1_VERSION=4.21.0
LIBTASN1_URL=https://ftp.gnu.org/gnu/libtasn1/libtasn1-${LIBTASN1_VERSION}.tar.gz
