# The image libraries against mlibc (libpng, libjpeg-turbo, libwebp,
# pixman), static, for cairo, gdk-pixbuf and GTK (issue #616): build output
# in target/image-libs-mlibc-<arch>. A library: no app; its smoke is the
# image-libs-smoke package's (docs/ports.md "Cache keys").
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc zlib x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="image-libs-mlibc-{arch}"
PORT_READY="image-libs-mlibc-{arch}/lib/libpixman-1.a"
PORT_FILES=""
