# The image libraries against mlibc (libpng, libjpeg-turbo, libwebp,
# pixman), static, for cairo, gdk-pixbuf and GTK (issue #616): build output
# in target/image-libs-mlibc-<arch>. The app is the package's smoke
# (smoke.c, its test), which draws through x11-libs' mlibc build too.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc zlib x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="image-libs-mlibc-{arch} image-smoke-mlibc-{none}"
PORT_READY="image-libs-mlibc-{arch}/lib/libpixman-1.a"
PORT_FILES="bin:image-smoke-mlibc-{none}:bin/custom/image-smoke"
PORT_TEST=test.sh
