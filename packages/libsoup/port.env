# The network libraries of WebKitGTK's stack against mlibc (libxml2,
# libpsl, nghttp2, libsoup 3, glib-networking over LibreSSL), static, for
# WebKitGTK (issue #616): build output in target/libsoup-mlibc-<arch>. The
# app is the package's smoke (smoke.c, its test).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx glib libressl sqlite"
PORT_BUILD=build.sh
PORT_OUTPUTS="libsoup-mlibc-{arch} libsoup-smoke-mlibc-{none}"
PORT_READY="libsoup-mlibc-{arch}/lib/libsoup-3.0.a"
PORT_FILES="bin:libsoup-smoke-mlibc-{none}:bin/custom/libsoup-smoke"
PORT_TEST=test.sh
