# SQLite (the amalgamation: libsqlite3.a and sqlite3.h), against mlibc for
# python's sqlite3 module: build output only, nothing in the image.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc"
PORT_BUILD=build.sh
PORT_OUTPUTS="sqlite-mlibc-{arch}"
PORT_READY="sqlite-mlibc-{arch}/lib/libsqlite3.a"
PORT_FILES=""
