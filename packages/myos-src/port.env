# The source this system was built from, as an app: the checked-in tree
# and every crate the kernel, its modules and the Rust programs are built
# of (vendor/, with the lock files that name them), so that myos builds
# its own kernel with the rustc package and no network
# (scripts/self-host.sh in the tree; packages/myos-src/README.md).
# /src/myos in the app. Not for an arch: one tree.
PORT_CORE=0
PORT_RDEPS="rustc"
PORT_BUILD=build.sh
PORT_OUTPUTS="myos-src"
PORT_READY="myos-src/Cargo.toml"
PORT_FILES="source:myos-src:src/myos"
PORT_TEST=test.sh
