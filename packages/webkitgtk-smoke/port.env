# WebKitGTK's program (smoke.c, its test): a browser window and WebKit's
# web and network processes in one binary, linked against mlibc from
# packages/webkitgtk's archive, with GIO's TLS backend and LibreSSL, which
# WebKit links but never compiles against: a change to them relinks this
# alone, not WebKit (issue #664).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx zlib glib image-libs cairo-pango x11-xft gtk3 libsoup libressl sqlite webkitgtk"
PORT_BUILD=build.sh
PORT_OUTPUTS="webkitgtk-smoke-mlibc-{none}"
PORT_FILES="bin:webkitgtk-smoke-mlibc-{none}:bin/custom/webkitgtk-smoke tree:webkitgtk-mlibc-{arch}/share/icu-data:lib/webkitgtk"
PORT_TEST=test.sh
