# The image libraries' smoke (packages/image-libs, docs/ports.md "Cache
# keys"), against mlibc: pixman, libpng, libjpeg-turbo and libwebp, and X
# through x11-libs' mlibc build (smoke.c, the package's test). A package of
# its own, not image-libs', so that a change to what it links and the
# libraries never compile against relinks it and rebuilds no library.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc zlib x11-libs image-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="image-smoke-mlibc-{none}"
PORT_FILES="bin:image-smoke-mlibc-{none}:bin/custom/image-smoke"
PORT_TEST=test.sh
