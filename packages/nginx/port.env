# nginx web server (poll events, PCRE2, gzip), with its configuration,
# MIME types and default pages under /lib/nginx.
PORT_CORE=0
PORT_DEPS="zlib pcre2"
PORT_BUILD=build.sh
PORT_OUTPUTS="nginx-{none} nginx-conf"
PORT_READY="nginx-{none}"
PORT_FILES="bin:nginx-{none}:bin/custom/nginx file:nginx.conf:lib/nginx/nginx.conf data:nginx-conf/mime.types:lib/nginx/mime.types data:nginx-conf/index.html:lib/nginx/html/index.html data:nginx-conf/50x.html:lib/nginx/html/50x.html"
PORT_TEST=test.sh
