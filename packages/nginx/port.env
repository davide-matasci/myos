# nginx web server (poll events, PCRE2, gzip, HTTPS over LibreSSL), with its
# configuration, MIME types and default pages under /lib/nginx.
PORT_CORE=0
PORT_DEPS="zlib pcre2 libressl"
PORT_BUILD=build.sh
PORT_OUTPUTS="nginx-{none} nginx-conf"
PORT_READY="nginx-{none}"
PORT_FILES="bin:nginx-{none}:bin/custom/nginx file:nginx.conf:lib/nginx/nginx.conf data:nginx-conf/mime.types:lib/nginx/mime.types data:nginx-conf/index.html:lib/nginx/html/index.html data:nginx-conf/50x.html:lib/nginx/html/50x.html file:test/localhost.crt:lib/myos-tests/nginx/localhost.crt file:test/localhost.key:lib/myos-tests/nginx/localhost.key file:test/other.crt:lib/myos-tests/nginx/other.crt file:test/other.key:lib/myos-tests/nginx/other.key file:test/client.crt:lib/myos-tests/nginx/client.crt file:test/client.key:lib/myos-tests/nginx/client.key"
# The test's certificates and keys (test/mkcerts.py), with the tests,
# out of the app's view.
PORT_TEST=test.sh
