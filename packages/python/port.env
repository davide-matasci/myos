# CPython 3.13, built against mlibc (docs/mlibc.md): the interpreter
# (/bin/custom/python3, python and python3.13) and its standard library
# (/lib/python3.13) as an app. The stdlib's extension modules are built in
# (static: sockets, select and epoll, threads and multiprocessing, zlib,
# the hashes, json, expat, decimal); _ssl, sqlite3, ctypes, curses and
# readline are not there (no port of their libraries on mlibc yet, issue
# #571).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc zlib"
PORT_BUILD=build.sh
PORT_OUTPUTS="python-{arch}"
PORT_READY="python-{arch}/usr/bin/python3.13"
PORT_FILES="bin:python-{arch}/usr/bin/python3.13:bin/custom/python3,bin/custom/python,bin/custom/python3.13 tree:python-{arch}/usr/lib/python3.13:lib/python3.13"
PORT_TEST=test.sh
