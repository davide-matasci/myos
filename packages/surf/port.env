# surf, suckless's browser, on packages/webkitgtk's WebKitGTK (the
# webkit2gtk-4.1 archive), against mlibc: one static binary that is the
# browser and WebKit's web and network processes; and its boot test's
# helper. Its address bar runs dmenu and xprop (x11-apps).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx zlib glib image-libs cairo-pango x11-xft gtk3 libsoup libressl sqlite webkitgtk"
PORT_RDEPS="x11-xft x11-fonts dmenu x11-apps"
PORT_BUILD=build.sh
PORT_OUTPUTS="surf-mlibc-{none} surf-check-mlibc-{none}"
# ICU's data, a file of its own (as packages/webkitgtk's): /lib/webkitgtk.
PORT_FILES="bin:surf-mlibc-{none}:bin/custom/surf bin:surf-check-mlibc-{none}:bin/etc/surf_check tree:webkitgtk-mlibc-{arch}/share/icu-data:lib/webkitgtk"
PORT_TEST=test.sh
