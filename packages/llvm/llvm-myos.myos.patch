new file mode 100644
index 000000000..4594b1289
--- /dev/null
+++ b/clang/lib/Driver/ToolChains/MyOS.cpp
@@ -0,0 +1,160 @@
+//===--- MyOS.cpp - myos ToolChain Implementations --------------*- C++ -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "MyOS.h"
+#include "CommonArgs.h"
+#include "clang/Driver/Compilation.h"
+#include "clang/Driver/Options.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualFileSystem.h"
+
+using namespace clang::driver;
+using namespace clang::driver::tools;
+using namespace clang::driver::toolchains;
+using namespace clang;
+using namespace llvm::opt;
+
+void myos::Linker::ConstructJob(Compilation &C, const JobAction &JA,
+                                const InputInfo &Output,
+                                const InputInfoList &Inputs,
+                                const ArgList &Args,
+                                const char *LinkingOutput) const {
+  const auto &ToolChain = static_cast<const MyOS &>(getToolChain());
+  const Driver &D = ToolChain.getDriver();
+  const bool Shared = Args.hasArg(options::OPT_shared);
+  const bool Relocatable = Args.hasArg(options::OPT_r);
+  ArgStringList CmdArgs;
+
+  // What says nothing to this link: a program is a static PIE whatever
+  // -static, -pie or -rdynamic ask, and the threads are the libc's.
+  Args.ClaimAllArgs(options::OPT_g_Group);
+  Args.ClaimAllArgs(options::OPT_emit_llvm);
+  Args.ClaimAllArgs(options::OPT_w);
+  Args.ClaimAllArgs(options::OPT_pie);
+  Args.ClaimAllArgs(options::OPT_static);
+  Args.ClaimAllArgs(options::OPT_static_pie);
+  Args.ClaimAllArgs(options::OPT_rdynamic);
+  Args.claimAllArgs(options::OPT_pthread, options::OPT_pthreads);
+
+  if (Relocatable) {
+    CmdArgs.push_back("-r");
+  } else if (Shared) {
+    CmdArgs.push_back("-shared");
+    CmdArgs.push_back("--hash-style=gnu");
+  } else {
+    // The kernel loads the program itself and relocates nothing: the
+    // program's crt0 does (mlibc's), and starts at _start.
+    CmdArgs.push_back("-pie");
+    CmdArgs.push_back("--no-dynamic-linker");
+    CmdArgs.push_back("--entry=_start");
+  }
+  CmdArgs.push_back("-z");
+  CmdArgs.push_back("max-page-size=4096");
+  // The index of .eh_frame (PT_GNU_EH_FRAME): where libunwind finds a
+  // throw's frames, through dl_iterate_phdr.
+  CmdArgs.push_back("--eh-frame-hdr");
+
+  assert((Output.isFilename() || Output.isNothing()) && "Invalid output.");
+  if (Output.isFilename()) {
+    CmdArgs.push_back("-o");
+    CmdArgs.push_back(Output.getFilename());
+  }
+
+  if (!Shared && !Relocatable &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nostartfiles))
+    CmdArgs.push_back(Args.MakeArgString(ToolChain.GetFilePath("crt0.o")));
+
+  Args.addAllArgs(CmdArgs, {options::OPT_L, options::OPT_T_Group,
+                            options::OPT_s, options::OPT_t});
+  if (Shared) {
+    // The system's libc.so before the development tree's libc.a.
+    CmdArgs.push_back(Args.MakeArgString("-L" + D.SysRoot + "/lib"));
+  }
+  ToolChain.AddFilePathLibArgs(Args, CmdArgs);
+
+  if (D.isUsingLTO()) {
+    assert(!Inputs.empty() && "Must have at least one input.");
+    auto Input = llvm::find_if(
+        Inputs, [](const InputInfo &II) -> bool { return II.isFilename(); });
+    if (Input == Inputs.end())
+      Input = Inputs.begin();
+    addLTOOptions(ToolChain, Args, CmdArgs, Output, *Input,
+                  D.getLTOMode() == LTOK_Thin);
+  }
+
+  addLinkerCompressDebugSectionsOption(ToolChain, Args, CmdArgs);
+  AddLinkerInputs(ToolChain, Inputs, Args, CmdArgs, JA);
+
+  if (!Relocatable &&
+      !Args.hasArg(options::OPT_nostdlib, options::OPT_nodefaultlibs)) {
+    if (D.CCCIsCXX() && ToolChain.ShouldLinkCXXStdlib(Args)) {
+      // libc++ (libc++abi is in it) and the unwinder name each other.
+      CmdArgs.push_back("--start-group");
+      ToolChain.AddCXXStdlibLibArgs(Args, CmdArgs);
+      CmdArgs.push_back("-lunwind");
+      CmdArgs.push_back("--end-group");
+    }
+    Args.ClaimAllArgs(options::OPT_stdlib_EQ);
+    // The libc, then the compiler's builtins, which it calls too.
+    CmdArgs.push_back("-lc");
+    CmdArgs.push_back("-lbuiltins");
+  }
+
+  const char *Exec = Args.MakeArgString(ToolChain.GetLinkerPath());
+  C.addCommand(std::make_unique<Command>(JA, *this,
+                                         ResponseFileSupport::AtFileCurCP(),
+                                         Exec, CmdArgs, Inputs, Output));
+}
+
+MyOS::MyOS(const Driver &D, const llvm::Triple &Triple, const ArgList &Args)
+    : Generic_ELF(D, Triple, Args) {
+  getFilePaths().clear();
+  getFilePaths().push_back(getDevelopmentDir() + "/lib");
+}
+
+std::string MyOS::getDevelopmentDir() const {
+  return getDriver().SysRoot + "/lib/mlibc";
+}
+
+void MyOS::AddClangSystemIncludeArgs(const ArgList &DriverArgs,
+                                     ArgStringList &CC1Args) const {
+  if (DriverArgs.hasArg(options::OPT_nostdinc))
+    return;
+
+  // mlibc's headers before the compiler's, as its ports are built.
+  if (!DriverArgs.hasArg(options::OPT_nostdlibinc))
+    addSystemInclude(DriverArgs, CC1Args, getDevelopmentDir() + "/include");
+
+  if (!DriverArgs.hasArg(options::OPT_nobuiltininc)) {
+    SmallString<128> Dir(getDriver().ResourceDir);
+    llvm::sys::path::append(Dir, "include");
+    addSystemInclude(DriverArgs, CC1Args, Dir.str());
+  }
+}
+
+void MyOS::addLibCxxIncludePaths(const ArgList &DriverArgs,
+                                 ArgStringList &CC1Args) const {
+  addSystemInclude(DriverArgs, CC1Args,
+                   getDevelopmentDir() + "/include/c++/v1");
+}
+
+void MyOS::addClangTargetOptions(const ArgList &DriverArgs,
+                                 ArgStringList &CC1Args,
+                                 Action::OffloadKind) const {
+  // mlibc's stdc-predef.h first, as glibc's is on Linux
+  // (__STDC_ISO_10646__: wchar_t holds Unicode).
+  if (DriverArgs.hasArg(options::OPT_nostdinc, options::OPT_nostdlibinc))
+    return;
+  std::string Predef = getDevelopmentDir() + "/include/stdc-predef.h";
+  if (getVFS().exists(Predef)) {
+    CC1Args.push_back("-include");
+    CC1Args.push_back(DriverArgs.MakeArgString(Predef));
+  }
+}
+
+Tool *MyOS::buildLinker() const { return new tools::myos::Linker(*this); }
