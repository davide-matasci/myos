+// myos target: the arch's generic ELF target (what `<arch>-unknown-none`
+// is, so that objects of either triple link together), with the system's
+// own macro. No `unix` macros: mlibc, libc++ and the ports are built
+// without them (libc++'s <locale> would look for catopen under __unix__).
+// _GNU_SOURCE in C++, as on Linux: libc++'s headers call the *_l locale
+// functions mlibc declares under it.
+template <typename Target>
+class LLVM_LIBRARY_VISIBILITY MyOSTargetInfo : public OSTargetInfo<Target> {
+protected:
+  void getOSDefines(const LangOptions &Opts, const llvm::Triple &Triple,
+                    MacroBuilder &Builder) const override {
+    Builder.defineMacro("__myos__");
+    if (Opts.POSIXThreads)
+      Builder.defineMacro("_REENTRANT");
+    if (Opts.CPlusPlus)
+      Builder.defineMacro("_GNU_SOURCE");
+  }
+
+public:
+  using OSTargetInfo<Target>::OSTargetInfo;
+};
