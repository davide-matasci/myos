# LLVM's compiler for myos, on myos: clang and lld (and the binutils:
# ar, nm, objcopy, strip, readelf, objdump, size) as one program,
# /bin/custom/clang, under each tool's name; built against mlibc and libc++
# with the X86, AArch64 and RISC-V backends. With it, what a program is
# compiled and linked against: clang's own headers (/lib/clang/22) and the
# development tree of the `<arch>-unknown-myos` target (/lib/mlibc: mlibc's
# headers and libc++'s, crt0.o, libc.a, the compiler builtins, libc++.a
# and libunwind.a). An app: `get-myos llvm`, then `run-myos llvm hello.c`
# (clang), `run-myos llvm:clang++`, `run-myos llvm:ld.lld`.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx"
PORT_BUILD=build.sh
PORT_OUTPUTS="llvm-{arch}"
PORT_READY="llvm-{arch}/bin/llvm"
PORT_FILES="bin:llvm-{arch}/bin/llvm:bin/custom/clang,bin/custom/clang++,bin/custom/ld.lld,bin/custom/lld,bin/custom/llvm-ar,bin/custom/llvm-ranlib,bin/custom/llvm-nm,bin/custom/llvm-objcopy,bin/custom/llvm-strip,bin/custom/llvm-readelf,bin/custom/llvm-objdump,bin/custom/llvm-size tree:llvm-{arch}/lib/clang/22:lib/clang/22 tree:llvm-{arch}/lib/mlibc:lib/mlibc"
PORT_TEST=test.sh
# One CI job per arch (LLVM and clang are hours of compiling), each cached
# apart.
PORT_ARCH_JOBS=1
PORT_TIMEOUT=340
