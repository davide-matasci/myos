# acme: acme.sh, the ACME client (Let's Encrypt and the other ACME CAs), a
# POSIX shell script over curl and the openssl app, staged as /lib/acme
# with its DNS, deploy and notify hooks; /bin/custom/acme runs it with its
# state under /data/acme (packages/acme/README.md). GPL-3.0.
PORT_CORE=0
PORT_RDEPS="openssl"
PORT_BUILD=build.sh
PORT_OUTPUTS="acme-app"
PORT_READY="acme-app/lib/acme/acme.sh"
PORT_FILES="tree:acme-app/lib/acme:lib/acme bin:acme-app/bin/custom/acme:bin/custom/acme"
PORT_TEST=test.sh
PORT_HOST=host.sh
