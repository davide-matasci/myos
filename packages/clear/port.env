# clear (ncurses): clears the terminal via the `clear` (termcap `cl`)
# capability. Built from the ncurses source already pinned by the ncurses
# package; linked against its static libncurses.a. Not in the image; get-myos
# installs it.
PORT_CORE=0
PORT_DEPS="ncurses"
PORT_BUILD=build.sh
PORT_OUTPUTS="clear-{none}"
PORT_FILES="bin:clear-{none}:bin/custom/clear"
PORT_TEST=test.sh
