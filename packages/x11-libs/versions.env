# Pins for the X client libraries (fetched at build; not vendored).
# Release tarballs from https://www.x.org/releases/individual/, or the same
# files from the mirrors when the X.Org server refuses CI's fetches; SHA-256
# of the .tar.xz files (unpacked with python3's lzma where xz is missing, as
# in the CI image).
X11_BASE_URL=https://www.x.org/releases/individual
# Distribution source caches, flat (no proto/, lib/): the x.org mirrors that
# keep a directory tree stopped updating in 2023.
X11_MIRROR_URLS="https://downloads.yoctoproject.org/mirror/sources https://ftp.netbsd.org/pub/pkgsrc/distfiles"
XORGPROTO_VERSION=2025.1
XORGPROTO_SHA256=56898c716c0578df8a2d828c9c3e5c528277705c0484381a81960fe1a67668e8
XTRANS_VERSION=1.6.0
XTRANS_SHA256=faafea166bf2451a173d9d593352940ec6404145c5d1da5c213423ce4d359e92
LIBXAU_VERSION=1.0.12
LIBXAU_SHA256=74d0e4dfa3d39ad8939e99bda37f5967aba528211076828464d2777d477fc0fb
XCB_PROTO_VERSION=1.17.0
XCB_PROTO_SHA256=2c1bacd2110f4799f74de6ebb714b94cf6f80fb112316b1219480fd22562148c
LIBXCB_VERSION=1.17.0
LIBXCB_SHA256=599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55
LIBX11_VERSION=1.8.13
LIBX11_SHA256=69606f485c2c07c14ef64f75b7bb326d48587af33795d9ab3e607c0b5f94f11c
# The common extensions' client library (MIT-SHM: XShm*, SHAPE, ...).
LIBXEXT_VERSION=1.3.6
