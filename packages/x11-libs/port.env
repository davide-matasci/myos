# The X client libraries (xcb, libX11): static libraries and headers for the
# X packages to link (target/x11-libs-<arch>), plus libX11's error database
# and the libraries' boot test against a stand-in server (x11_smoke.c).
PORT_CORE=0
PORT_BUILD=build.sh
PORT_OUTPUTS="x11-smoke-{none} x11-libs-{arch}"
PORT_FILES="bin:x11-smoke-{none}:bin/etc/x11_smoke data:x11-libs-{arch}/lib/X11/XErrorDB:lib/X11/XErrorDB"
PORT_TEST=test.sh
