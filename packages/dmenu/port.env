# dmenu, the menu (dwm's Alt+P runs its dmenu_run), with stest and the
# dmenu_run / dmenu_path scripts; and its boot test.
PORT_CORE=0
PORT_DEPS="x11-xft"
PORT_RDEPS="x11-xft x11-fonts"
PORT_BUILD=build.sh
PORT_OUTPUTS="dmenu-{none} stest-{none} dmenu-smoke-{none} dmenu_run dmenu_path"
PORT_FILES="bin:dmenu-{none}:bin/custom/dmenu bin:stest-{none}:bin/custom/stest data:dmenu_run:bin/custom/dmenu_run data:dmenu_path:bin/custom/dmenu_path bin:dmenu-smoke-{none}:bin/etc/dmenu_smoke"
PORT_TEST=test.sh
