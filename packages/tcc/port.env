# TinyCC as /bin/tcc/tcc with libtcc1, and what it compiles against: the
# newlib sysroot (/lib/newlib/include and /lib/newlib/lib, libtcc1.a among
# them, which tcc's build installs there), the compiler headers tcc needs
# beside it (tcc-include: stddef.h, stdarg.h, ...) and crt1.o, newlib's
# crt0.o under the name a hosted link asks for. A package: compiling on the
# running system is `get-myos tcc`, then `run-myos tcc`.
PORT_CORE=0
PORT_BUILD=build.sh
PORT_OUTPUTS="tcc-{myos} libtcc1-{myos}.a tcc-include"
PORT_READY="tcc-{myos}"
PORT_FILES="bin:tcc-{myos}:bin/tcc/tcc tree:newlib-{arch}/{myos}/include:lib/newlib/include tree:tcc-include:lib/newlib/include tree:newlib-{arch}/{myos}/lib:lib/newlib/lib data:newlib-{arch}/{myos}/lib/crt0.o:lib/newlib/lib/crt1.o"
PORT_TEST=test.sh
