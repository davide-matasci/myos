# TinyX's Xfbdev, the X server: on /dev/fb (the screen) and
# /dev/console/kbd (the keyboard), no mouse; and its boot test.
PORT_CORE=0
PORT_DEPS="x11-libs zlib"
PORT_BUILD=build.sh
PORT_OUTPUTS="xfbdev-{none} tinyx-smoke-{none}"
PORT_FILES="bin:xfbdev-{none}:bin/custom/Xfbdev bin:tinyx-smoke-{none}:bin/etc/tinyx_smoke"
PORT_TEST=test.sh
