# TinyX's Xfbdev, the X server: on /dev/fb (the screen) and
# /dev/console/kbd (the keyboard), no mouse; startx, which runs a session
# (Xfbdev, then dwm or another client); and the boot test.
PORT_CORE=0
PORT_DEPS="x11-libs zlib"
PORT_BUILD=build.sh
PORT_OUTPUTS="xfbdev-{none} tinyx-smoke-{none} startx-{none}"
PORT_FILES="bin:xfbdev-{none}:bin/custom/Xfbdev bin:tinyx-smoke-{none}:bin/etc/tinyx_smoke bin:startx-{none}:bin/custom/startx"
PORT_TEST=test.sh
