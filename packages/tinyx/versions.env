# Pins for TinyX and the libraries it needs beyond packages/x11-libs
# (fetched at build; not vendored).
# TinyX (Tiny Core's kdrive servers): a commit of its master branch.
TINYX_URL=https://github.com/tinycorelinux/tinyx.git
TINYX_REV=feab72ca891bc04b18763763e15ee4e532369cdf
# X.Org release tarballs (https://www.x.org/releases/individual/lib/), or
# the same files from the mirrors (as in packages/x11-libs); SHA-256 of the
# .tar.xz files but libXfont's.
X11_LIB_URL=https://www.x.org/releases/individual/lib
X11_MIRROR_URLS="https://downloads.yoctoproject.org/mirror/sources https://ftp.netbsd.org/pub/pkgsrc/distfiles"
LIBFONTENC_VERSION=1.1.9
LIBFONTENC_SHA256=9d8392705cb10803d5fe1d27d236cbab3f664e26841ce01916bbbe430cf273e2
# libXfont 1.x: TinyX predates libXfont2. The source caches hold only its
# .tar.bz2 (no bzip2 in the CI image); an x.org mirror that stopped in 2023
# still has the .tar.gz.
LIBXFONT_VERSION=1.5.4
LIBXFONT_SHA256=59be6eab53f7b0feb6b7933c11d67d076ae2c0fd8921229c703fc7a4e9a80d6e
LIBXFONT_MIRROR_URL=https://mirror.csclub.uwaterloo.ca/x.org/individual/lib
# Only its header (TinyX's os/ includes it with XDMCP off).
LIBXDMCP_VERSION=1.1.5
LIBXDMCP_SHA256=d8a5222828c3adab70adf69a5583f1d32eb5ece04304f7f8392b6a353aa2228c
