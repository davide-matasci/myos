diff --git a/kdrive/myos/keyboard.c b/kdrive/myos/keyboard.c
new file mode 100644
index 0000000..edd99cb
--- /dev/null
+++ b/kdrive/myos/keyboard.c
@@ -0,0 +1,246 @@
+/*
+ * myos: the keyboard, from /dev/console/kbd (docs/tty.md).
+ *
+ * The file reports every press and release as a line, "d <code>[ <char>]"
+ * or "u <code>", with Linux KEY_* codes: the scan codes kdrive expects
+ * (the X keycode is the code + 8, as with evdev). Opening it takes the
+ * keyboard from the console until the server closes it.
+ *
+ * The keymap: the keys that are not characters (Esc, the modifiers, the
+ * function keys, the keypad, the arrows) from the table below; the
+ * characters from the console's keymap file (the `keymap` line of
+ * /dev/console/ctl, docs/keymap.md: base, Shift, AltGr, Shift+AltGr, the
+ * four columns of an X keymap with AltGr as Mode_switch), US when there is
+ * none. Its bytes are Latin-1, which are their own keysyms.
+ *
+ * Part of the myos patches to TinyX (packages/tinyx), under TinyX's license.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "kdrive.h"
+#include "kkeymap.h"
+#include <X11/keysym.h>
+
+#define KBD "/dev/console/kbd"
+#define CONSOLE_CTL "/dev/console/ctl"
+#define NCODES 128
+
+static int MyosKbdType;
+
+static KeySym *row(int code)
+{
+	return &kdKeymap[(code - kdMinScanCode) * KD_MAX_WIDTH];
+}
+
+static void set_keys(int code, KeySym base, KeySym shift)
+{
+	row(code)[0] = base;
+	row(code)[1] = shift;
+}
+
+/* The keys that are not characters, by Linux code. */
+static void load_fixed(void)
+{
+	static const struct {
+		unsigned char code;
+		KeySym base, shift;
+	} fixed[] = {
+		{1, XK_Escape, NoSymbol}, {14, XK_BackSpace, NoSymbol},
+		{15, XK_Tab, XK_ISO_Left_Tab}, {28, XK_Return, NoSymbol},
+		{29, XK_Control_L, NoSymbol}, {42, XK_Shift_L, NoSymbol},
+		{54, XK_Shift_R, NoSymbol}, {55, XK_KP_Multiply, NoSymbol},
+		{56, XK_Alt_L, XK_Meta_L}, {57, XK_space, NoSymbol},
+		{58, XK_Caps_Lock, NoSymbol}, {69, XK_Num_Lock, NoSymbol},
+		{70, XK_Scroll_Lock, NoSymbol},
+		{71, XK_KP_Home, XK_KP_7}, {72, XK_KP_Up, XK_KP_8},
+		{73, XK_KP_Prior, XK_KP_9}, {74, XK_KP_Subtract, NoSymbol},
+		{75, XK_KP_Left, XK_KP_4}, {76, XK_KP_Begin, XK_KP_5},
+		{77, XK_KP_Right, XK_KP_6}, {78, XK_KP_Add, NoSymbol},
+		{79, XK_KP_End, XK_KP_1}, {80, XK_KP_Down, XK_KP_2},
+		{81, XK_KP_Next, XK_KP_3}, {82, XK_KP_Insert, XK_KP_0},
+		{83, XK_KP_Delete, XK_KP_Decimal},
+		{87, XK_F11, NoSymbol}, {88, XK_F12, NoSymbol},
+		{96, XK_KP_Enter, NoSymbol}, {97, XK_Control_R, NoSymbol},
+		{98, XK_KP_Divide, NoSymbol}, {99, XK_Print, NoSymbol},
+		{100, XK_Mode_switch, NoSymbol}, {102, XK_Home, NoSymbol},
+		{103, XK_Up, NoSymbol}, {104, XK_Prior, NoSymbol},
+		{105, XK_Left, NoSymbol}, {106, XK_Right, NoSymbol},
+		{107, XK_End, NoSymbol}, {108, XK_Down, NoSymbol},
+		{109, XK_Next, NoSymbol}, {110, XK_Insert, NoSymbol},
+		{111, XK_Delete, NoSymbol}, {119, XK_Pause, NoSymbol},
+		{125, XK_Super_L, NoSymbol}, {126, XK_Super_R, NoSymbol},
+		{127, XK_Menu, NoSymbol},
+	};
+	unsigned i;
+	int f;
+
+	for (i = 0; i < sizeof fixed / sizeof fixed[0]; i++)
+		set_keys(fixed[i].code, fixed[i].base, fixed[i].shift);
+	for (f = 0; f < 10; f++)
+		set_keys(59 + f, XK_F1 + f, NoSymbol);
+}
+
+/* US characters, base and Shift, by Linux code. */
+static void load_us(void)
+{
+	static const char *const us[NCODES] = {
+		[2] = "1!", [3] = "2@", [4] = "3#", [5] = "4$", [6] = "5%",
+		[7] = "6^", [8] = "7&", [9] = "8*", [10] = "9(", [11] = "0)",
+		[12] = "-_", [13] = "=+", [16] = "qQ", [17] = "wW", [18] = "eE",
+		[19] = "rR", [20] = "tT", [21] = "yY", [22] = "uU", [23] = "iI",
+		[24] = "oO", [25] = "pP", [26] = "[{", [27] = "]}", [30] = "aA",
+		[31] = "sS", [32] = "dD", [33] = "fF", [34] = "gG", [35] = "hH",
+		[36] = "jJ", [37] = "kK", [38] = "lL", [39] = ";:", [40] = "'\"",
+		[41] = "`~", [43] = "\\|", [44] = "zZ", [45] = "xX", [46] = "cC",
+		[47] = "vV", [48] = "bB", [49] = "nN", [50] = "mM", [51] = ",<",
+		[52] = ".>", [53] = "/?", [86] = "<>",
+	};
+	int code;
+
+	for (code = 0; code < NCODES; code++)
+		if (us[code])
+			set_keys(code, (unsigned char)us[code][0], (unsigned char)us[code][1]);
+}
+
+/* A level of a keymap file line (docs/keymap.md) as a keysym. */
+static KeySym map_token(const char *t)
+{
+	unsigned long b;
+
+	if (!strcmp(t, "none"))
+		return NoSymbol;
+	if (!strcmp(t, "ENTER") || !strcmp(t, "\\n"))
+		return XK_Return;
+	if (!strcmp(t, "TAB") || !strcmp(t, "\\t"))
+		return XK_Tab;
+	if (!strcmp(t, "BKSP") || !strcmp(t, "\\b"))
+		return XK_BackSpace;
+	if (!strcmp(t, "SPACE"))
+		return XK_space;
+	if ((t[0] == '\\' || t[0] == '0') && t[1] == 'x' && t[2])
+		b = strtoul(t + 2, NULL, 16);
+	else if (t[0] && !t[1])
+		b = (unsigned char)t[0];
+	else
+		return NoSymbol;
+	return (b >= 0x20 && b < 0x7f) || (b >= 0xa0 && b <= 0xff) ? (KeySym)b : NoSymbol;
+}
+
+/* The path on the console's `keymap` line, or NULL ("none", no line). */
+static char *console_keymap(char *buf, size_t len)
+{
+	char ctl[1024], *line;
+	int fd = open(CONSOLE_CTL, O_RDONLY);
+	ssize_t n;
+
+	if (fd < 0)
+		return NULL;
+	n = read(fd, ctl, sizeof ctl - 1);
+	close(fd);
+	if (n <= 0)
+		return NULL;
+	ctl[n] = '\0';
+	for (line = strtok(ctl, "\n"); line; line = strtok(NULL, "\n"))
+		if (!strncmp(line, "keymap ", 7) && strcmp(line + 7, "none")) {
+			snprintf(buf, len, "%s", line + 7);
+			return buf;
+		}
+	return NULL;
+}
+
+static void load_file(void)
+{
+	char path[512], line[256];
+	FILE *f;
+
+	if (!console_keymap(path, sizeof path) || !(f = fopen(path, "r")))
+		return;
+	while (fgets(line, sizeof line, f)) {
+		char lv[4][16];
+		unsigned code;
+		int i;
+
+		if (sscanf(line, " keycode %i = %15s %15s %15s %15s", (int *)&code,
+			   lv[0], lv[1], lv[2], lv[3]) != 5 || code == 0 || code >= NCODES)
+			continue;
+		for (i = 0; i < 4; i++)
+			row(code)[i] = map_token(lv[i]);
+	}
+	fclose(f);
+}
+
+static void MyosKeyboardLoad(void)
+{
+	kdMinScanCode = 0;
+	kdMaxScanCode = NCODES - 1;
+	memset(kdKeymap, 0, sizeof kdKeymap);
+	load_fixed();
+	load_us();
+	load_file();
+}
+
+/* Called when select() says the file is readable: one read, which returns
+ * whole lines and does not block then. */
+static void MyosKeyboardRead(int fd, void *closure)
+{
+	char buf[512], *line, *save;
+	ssize_t n = read(fd, buf, sizeof buf - 1);
+
+	if (n <= 0)
+		return;
+	buf[n] = '\0';
+	for (line = strtok_r(buf, "\n", &save); line; line = strtok_r(NULL, "\n", &save)) {
+		char *end;
+		long code = strtol(line + 2, &end, 10);
+
+		if ((line[0] != 'd' && line[0] != 'u') || line[1] != ' ' || end == line + 2)
+			continue;
+		if (code > 0 && code < NCODES)
+			KdEnqueueKeyboardEvent((unsigned char)code, line[0] == 'u');
+	}
+}
+
+static int MyosKeyboardInit(void)
+{
+	int fd;
+
+	if (!MyosKbdType)
+		MyosKbdType = KdAllocInputType();
+	fd = open(KBD, O_RDONLY);
+	if (fd < 0) {
+		ErrorF("myos: %s: %s (no keyboard)\n", KBD, strerror(errno));
+		return 0;
+	}
+	KdRegisterFd(MyosKbdType, fd, MyosKeyboardRead, 0);
+	return 1;
+}
+
+static void MyosKeyboardFini(void)
+{
+	/* The last close gives the keyboard back to the console. */
+	KdUnregisterFds(MyosKbdType, TRUE);
+}
+
+static void MyosKeyboardLeds(int leds)
+{
+}
+
+static void MyosKeyboardBell(int volume, int pitch, int duration)
+{
+}
+
+const KdKeyboardFuncs MyosKeyboardFuncs = {
+	MyosKeyboardLoad,
+	MyosKeyboardInit,
+	MyosKeyboardLeds,
+	MyosKeyboardBell,
+	MyosKeyboardFini,
+	3,
+};
diff --git a/kdrive/myos/myos.c b/kdrive/myos/myos.c
new file mode 100644
index 0000000..d20deec
--- /dev/null
+++ b/kdrive/myos/myos.c
@@ -0,0 +1,63 @@
+/*
+ * myos: kdrive's OS layer. Nothing to switch: myos has one console, and the
+ * screen and the keyboard are taken by opening their files (/dev/fb/ctl,
+ * kdrive/fbdev/myosfb.c; /dev/console/kbd, keyboard.c) and given back when
+ * they close, the server's exit included. No mouse (the core pointer
+ * exists and never moves).
+ *
