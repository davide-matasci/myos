diff --git a/kdrive/fbdev/myosfb.c b/kdrive/fbdev/myosfb.c
new file mode 100644
index 0000000..e01f1ba
--- /dev/null
+++ b/kdrive/fbdev/myosfb.c
@@ -0,0 +1,151 @@
+/*
+ * myos: the framebuffer ioctls fbdev.c makes, answered from /dev/fb/ctl.
+ *
+ * myos's framebuffer is a directory (docs/fb.md): `ctl` reads as one line,
+ * "width height depth chan pitch mode" (e.g. "1280 800 32 x8r8g8b8 5120
+ * text"), and `data` is the pixels, mapped MAP_SHARED. The mode is the one
+ * the bootloader set; there is no mode setting and no colormap. Writing
+ * "graphics" to `ctl` takes the screen from the text console; the console
+ * takes it back when the fd closes, so the server holds it open until it
+ * exits.
+ *
+ * Part of the myos patches to TinyX (packages/tinyx), under TinyX's license.
+ */
+#ifdef HAVE_CONFIG_H
+#include <kdrive-config.h>
+#endif
+#include <errno.h>
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <linux/fb.h>
+
+#undef ioctl
+
+#define CTL "/dev/fb/ctl"
+
+static int ctl_fd = -1;
+static struct fb_var_screeninfo cur_var;
+static struct fb_fix_screeninfo cur_fix;
+
+/* "x8r8g8b8": components from the most significant bits down. */
+static int parse_chan(const char *chan, struct fb_var_screeninfo *var)
+{
+	int bits = 0, i;
+
+	for (i = 0; chan[i]; i += 2)
+		if (chan[i + 1] < '1' || chan[i + 1] > '9')
+			return -1;
+		else
+			bits += chan[i + 1] - '0';
+	for (i = 0; chan[i]; i += 2) {
+		int len = chan[i + 1] - '0';
+		struct fb_bitfield *f = NULL;
+
+		bits -= len;
+		switch (chan[i]) {
+		case 'r': f = &var->red; break;
+		case 'g': f = &var->green; break;
+		case 'b': f = &var->blue; break;
+		case 'a': f = &var->transp; break;
+		case 'x': break;
+		default: return -1;
+		}
+		if (f) {
+			f->offset = bits;
+			f->length = len;
+		}
+	}
+	return 0;
+}
+
+/* Read the geometry and take the screen (once). */
+static int fb_open_ctl(void)
+{
+	char line[128], chan[16], mode[16];
+	unsigned w, h, depth, pitch;
+	ssize_t n;
+
+	if (ctl_fd >= 0)
+		return 0;
+	ctl_fd = open(CTL, O_RDWR);
+	if (ctl_fd < 0)
+		return -1;
+	n = read(ctl_fd, line, sizeof line - 1);
+	if (n <= 0) {
+		close(ctl_fd);
+		ctl_fd = -1;
+		return -1;
+	}
+	line[n] = '\0';
+	if (sscanf(line, "%u %u %u %15s %u %15s", &w, &h, &depth, chan, &pitch, mode) != 6
+	    || parse_chan(chan, &cur_var) < 0) {
+		close(ctl_fd);
+		ctl_fd = -1;
+		errno = EINVAL;
+		return -1;
+	}
+	cur_var.xres = cur_var.xres_virtual = w;
+	cur_var.yres = cur_var.yres_virtual = h;
+	cur_var.bits_per_pixel = depth;
+	strcpy(cur_fix.id, "myos");
+	cur_fix.smem_len = pitch * h;
+	cur_fix.type = FB_TYPE_PACKED_PIXELS;
+	cur_fix.visual = FB_VISUAL_TRUECOLOR;
+	cur_fix.line_length = pitch;
+	if (write(ctl_fd, "graphics\n", 9) != 9) {
+		close(ctl_fd);
+		ctl_fd = -1;
+		return -1;
+	}
+	return 0;
+}
+
+int myos_fb_ioctl(int fd, unsigned long request, ...)
+{
+	va_list ap;
+	void *arg;
+
+	va_start(ap, request);
+	arg = va_arg(ap, void *);
+	va_end(ap);
+
+	switch (request) {
+	case FBIOGET_FSCREENINFO:
+		if (fb_open_ctl() < 0)
+			return -1;
+		memcpy(arg, &cur_fix, sizeof cur_fix);
+		return 0;
+	case FBIOGET_VSCREENINFO:
+		if (fb_open_ctl() < 0)
+			return -1;
+		memcpy(arg, &cur_var, sizeof cur_var);
+		return 0;
+	case FBIOPUT_VSCREENINFO: {
+		/* No mode setting: only the current mode is accepted. */
+		struct fb_var_screeninfo *var = arg;
+
+		if (fb_open_ctl() < 0)
+			return -1;
+		if (var->xres != cur_var.xres || var->yres != cur_var.yres
+		    || var->bits_per_pixel != cur_var.bits_per_pixel) {
+			errno = EINVAL;
+			return -1;
+		}
+		memcpy(var, &cur_var, sizeof cur_var);
+		return 0;
+	}
+	case FBIOBLANK:
+		return 0;
+	case FBIOGETCMAP:
+	case FBIOPUTCMAP:
+		/* TrueColor only: there is no colormap. */
+		errno = EINVAL;
+		return -1;
+	default:
+		return ioctl(fd, request, arg);
+	}
+}
