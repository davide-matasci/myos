# Pin for GNU make (fetched at build; not vendored).
MAKE_VERSION=4.4.1
# Where the tarball comes from, first that answers: GNU's redirector to a
# nearby mirror, a mirror outside GNU's own servers (they go down
# together), then ftp.gnu.org itself.
MAKE_URLS="https://ftpmirror.gnu.org/gnu/make/make-${MAKE_VERSION}.tar.gz
https://mirror.yandex.ru/mirrors/gnu/make/make-${MAKE_VERSION}.tar.gz
https://ftp.gnu.org/gnu/make/make-${MAKE_VERSION}.tar.gz"
MAKE_SHA256=dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3
