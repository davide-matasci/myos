# The fonts for the X clients drawing with Xft: DejaVu Sans Mono in
# /lib/fonts (the x11-xft package's fonts.conf), with its license.
PORT_CORE=0
PORT_BUILD=build.sh
PORT_OUTPUTS="x11-fonts"
PORT_READY="x11-fonts/DejaVuSansMono.ttf"
PORT_FILES="data:x11-fonts/DejaVuSansMono.ttf:lib/fonts/DejaVuSansMono.ttf data:x11-fonts/DejaVuSansMono-Bold.ttf:lib/fonts/DejaVuSansMono-Bold.ttf data:x11-fonts/DejaVuSansMono-Oblique.ttf:lib/fonts/DejaVuSansMono-Oblique.ttf data:x11-fonts/DejaVuSansMono-BoldOblique.ttf:lib/fonts/DejaVuSansMono-BoldOblique.ttf data:x11-fonts/LICENSE.DejaVu:lib/fonts/LICENSE.DejaVu"
