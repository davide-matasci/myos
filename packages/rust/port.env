# rust: Rust for myos programs, in myos. The app carries the myos std
# sysroot of its arch (/lib/rust: the rlibs and the target spec) and
# /bin/custom/rust, which installs the pinned nightly's official musl
# toolchain (versions.env, fetched at run time, never shipped) into an
# Alpine root and runs cargo there under the Linux layer
# (packages/rust/README.md).
PORT_CORE=0
PORT_DEPS="sysroot"
PORT_RDEPS="get-alpine"
PORT_BUILD=build.sh
PORT_OUTPUTS="rust-{arch}"
PORT_READY="rust-{arch}/bin/custom/rust"
PORT_FILES="tree:rust-{arch}/lib/rust:lib/rust bin:rust-{arch}/bin/custom/rust:bin/custom/rust"
PORT_TEST=test.sh
