# get-alpine: the Alpine Linux package fetcher of the optional Linux layer
# (docs/linux-compat.md). A native myos program (newlib, the zlib port and
# get-myos's pkgtools), so a package: `get-myos get-alpine` installs it on
# any system, `run-myos get-alpine PACKAGE...` runs it. What it fetches runs
# with the `linux` module loaded (`insmod /lib/modules/linux`).
PORT_CORE=0
PORT_DEPS="zlib"
PORT_BUILD=build.sh
PORT_OUTPUTS="get-alpine-{none}"
PORT_FILES="bin:get-alpine-{none}:bin/custom/get-alpine"
PORT_TEST=test.sh
