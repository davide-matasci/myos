# GLib's programs (packages/glib, docs/ports.md "Cache keys"): GIO's gio,
# linked from the objects GLib's build leaves, and the smoke (smoke.c,
# the package's test), against mlibc. A package of its own, not glib's,
# so that a change to what they link and GLib never compiles against (the
# libc's C) relinks them and rebuilds no library.
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc zlib pcre2 glib"
PORT_BUILD=build.sh
PORT_OUTPUTS="gio-mlibc-{none} glib-smoke-mlibc-{none}"
PORT_FILES="bin:gio-mlibc-{none}:bin/custom/gio bin:glib-smoke-mlibc-{none}:bin/custom/glib-smoke"
PORT_TEST=test.sh
