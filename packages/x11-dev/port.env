# The X client libraries for building X programs on myos with tcc: the
# headers and the static libraries of packages/x11-libs' newlib build, at
# /lib/x11 (the prefix they were built for, which tcc searches), libX11.a
# with libxcb and libXau merged into it so `-lX11` links alone.
PORT_CORE=0
PORT_DEPS="x11-libs"
PORT_RDEPS="x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="x11-dev-{arch}"
PORT_READY="x11-dev-{arch}/lib/x11/lib/libX11.a"
PORT_FILES="tree:x11-dev-{arch}/lib/x11/include:lib/x11/include tree:x11-dev-{arch}/lib/x11/lib:lib/x11/lib"
PORT_TEST=test.sh
