# The client-side font stack (expat, FreeType, fontconfig, libXft):
# static libraries and headers for the X packages that draw text with Xft
# (target/x11-xft-<arch>, x11-libs' included; the mlibc builds in
# x11-xft-mlibc-<arch>), fontconfig's
# configuration, fc-match and fc-list, and the stack's boot test against
# Xfbdev (xft_smoke.c).
PORT_CORE=0
PORT_DEPS="x11-libs"
PORT_RDEPS="x11-libs"
PORT_BUILD=build.sh
PORT_OUTPUTS="x11-xft-{arch} x11-xft-mlibc-{arch} xft-smoke-{none} fc-match-{none} fc-list-{none}"
PORT_READY="xft-smoke-x86_64-unknown-none"
PORT_FILES="file:fonts.conf:lib/x11/etc/fonts/fonts.conf bin:fc-match-{none}:bin/custom/fc-match bin:fc-list-{none}:bin/custom/fc-list bin:xft-smoke-{none}:bin/etc/xft_smoke"
PORT_TEST=test.sh
