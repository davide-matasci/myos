# bottom (btm), a system monitor in Rust on the myos std: its CPU, memory
# and process widgets from /proc; and its boot test's pty driver.
PORT_CORE=0
PORT_DEPS="sysroot"
PORT_BUILD=build.sh
PORT_OUTPUTS="btm-{myos} btm-smoke-{none}"
PORT_FILES="bin:btm-{myos}:bin/custom/btm bin:btm-smoke-{none}:bin/etc/btm_smoke"
PORT_TEST=test.sh
