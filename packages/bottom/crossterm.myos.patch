diff -ruN a/src/event/source/unix/myos.rs b/src/event/source/unix/myos.rs
--- a/src/event/source/unix/myos.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/event/source/unix/myos.rs	2026-10-07 14:04:16.712973195 +0000
@@ -0,0 +1,143 @@
+//! The event source on myos: the terminal's input, waited for with
+//! `poll(2)`. myos sends no `SIGWINCH`, so a change of the terminal's size
+//! is found by looking at it while waiting, every quarter second: a look
+//! costs a few system calls (`/dev/tty` and the terminal's `ctl` file), and
+//! callers poll in a loop with short timeouts (bottom: 20 ms).
+
+use std::{
+    collections::VecDeque,
+    io,
+    time::{Duration, Instant},
+};
+
+use crate::event::timeout::PollTimeout;
+use crate::event::Event;
+use crate::event::{source::EventSource, sys::unix::parse::parse_event, InternalEvent};
+use crate::terminal::sys::file_descriptor::{tty_fd, FileDesc};
+
+const TTY_BUFFER_SIZE: usize = 1_024;
+
+/// How often the size is looked at.
+const SIZE_CHECK: Duration = Duration::from_millis(250);
+
+pub(crate) struct UnixInternalEventSource {
+    parser: Parser,
+    tty_buffer: [u8; TTY_BUFFER_SIZE],
+    tty: FileDesc<'static>,
+    size: Option<(u16, u16)>,
+    size_checked: Instant,
+}
+
+impl UnixInternalEventSource {
+    pub fn new() -> io::Result<Self> {
+        UnixInternalEventSource::from_file_descriptor(tty_fd()?)
+    }
+
+    pub(crate) fn from_file_descriptor(input_fd: FileDesc<'static>) -> io::Result<Self> {
+        Ok(UnixInternalEventSource {
+            parser: Parser::default(),
+            tty_buffer: [0u8; TTY_BUFFER_SIZE],
+            tty: input_fd,
+            size: crate::terminal::size().ok(),
+            size_checked: Instant::now(),
+        })
+    }
+
+    /// A resize event when the terminal's size changed since last looked at
+    /// (at most every `SIZE_CHECK`).
+    fn resized(&mut self) -> Option<InternalEvent> {
+        if self.size_checked.elapsed() < SIZE_CHECK {
+            return None;
+        }
+        self.size_checked = Instant::now();
+        let now = crate::terminal::size().ok()?;
+        if self.size.replace(now) == Some(now) {
+            return None;
+        }
+        Some(InternalEvent::Event(Event::Resize(now.0, now.1)))
+    }
+}
+
+impl EventSource for UnixInternalEventSource {
+    fn try_read(&mut self, timeout: Option<Duration>) -> io::Result<Option<InternalEvent>> {
+        let timeout = PollTimeout::new(timeout);
+
+        while timeout.leftover().map_or(true, |t| !t.is_zero()) {
+            if let Some(event) = self.parser.next() {
+                return Ok(Some(event));
+            }
+            if let Some(event) = self.resized() {
+                return Ok(Some(event));
+            }
+            let wait = timeout.leftover().map_or(SIZE_CHECK, |t| t.min(SIZE_CHECK));
+            let mut fd = libc::pollfd {
+                fd: self.tty.raw_fd(),
+                events: libc::POLLIN,
+                revents: 0,
+            };
+            let ready = unsafe { libc::poll(&mut fd, 1, wait.as_millis() as libc::c_int) };
+            if ready < 0 {
+                let e = io::Error::last_os_error();
+                if e.kind() == io::ErrorKind::Interrupted {
+                    continue;
+                }
+                return Err(e);
+            }
+            if ready > 0 && fd.revents & libc::POLLIN != 0 {
+                // Raw mode: a read returns what has arrived, at least a byte.
+                let read_count = self.tty.read(&mut self.tty_buffer)?;
+                if read_count > 0 {
+                    self.parser
+                        .advance(&self.tty_buffer[..read_count], read_count == TTY_BUFFER_SIZE);
+                }
+                if let Some(event) = self.parser.next() {
+                    return Ok(Some(event));
+                }
+            }
+        }
+        Ok(None)
+    }
+}
+
+// The parser of the other unix sources (`tty.rs`).
+#[derive(Debug)]
+struct Parser {
+    buffer: Vec<u8>,
+    internal_events: VecDeque<InternalEvent>,
+}
+
+impl Default for Parser {
+    fn default() -> Self {
+        Parser {
+            buffer: Vec::with_capacity(256),
+            internal_events: VecDeque::with_capacity(128),
+        }
+    }
+}
+
+impl Parser {
+    fn advance(&mut self, buffer: &[u8], more: bool) {
+        for (idx, byte) in buffer.iter().enumerate() {
+            let more = idx + 1 < buffer.len() || more;
+
+            self.buffer.push(*byte);
+
+            match parse_event(&self.buffer, more) {
+                Ok(Some(ie)) => {
+                    self.internal_events.push_back(ie);
+                    self.buffer.clear();
+                }
+                Ok(None) => {}
+                Err(_) => self.buffer.clear(),
+            }
+        }
+    }
+}
+
+impl Iterator for Parser {
+    type Item = InternalEvent;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.internal_events.pop_front()
+    }
+}
