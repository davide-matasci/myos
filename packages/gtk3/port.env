# GTK 3 (its X11 backend) and ATK against mlibc, static, for WebKitGTK and
# surf (issue #616): build output in target/gtk3-mlibc-<arch>. A library:
# no app; its smoke is the gtk3-smoke package's (docs/ports.md "Cache
# keys").
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx glib image-libs cairo-pango x11-xft"
PORT_BUILD=build.sh
PORT_OUTPUTS="gtk3-mlibc-{arch}"
PORT_READY="gtk3-mlibc-{arch}/lib/libgtk-3.a"
PORT_FILES=""
