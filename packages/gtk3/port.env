# GTK 3 (its X11 backend) and ATK against mlibc, static, for WebKitGTK and
# surf (issue #616): build output in target/gtk3-mlibc-<arch>. The app is
# the package's smoke (smoke.c, its test).
PORT_CORE=0
PORT_LIBC=mlibc
PORT_DEPS="mlibc libcxx glib image-libs cairo-pango x11-xft"
PORT_BUILD=build.sh
PORT_OUTPUTS="gtk3-mlibc-{arch} gtk3-smoke-mlibc-{none}"
PORT_READY="gtk3-mlibc-{arch}/lib/libgtk-3.a"
PORT_FILES="bin:gtk3-smoke-mlibc-{none}:bin/custom/gtk3-smoke"
PORT_TEST=test.sh
