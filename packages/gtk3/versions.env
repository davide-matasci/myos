# Pins for GTK 3 and ATK (fetched at build; not vendored): the release
# tarballs and their SHA-256 (download.gnome.org's .sha256sum).
# ATK 2.38: the last release of its own (later ones are part of
# at-spi2-core, which needs D-Bus); GTK 3 wants 2.35.1 or later.
ATK_VERSION=2.38.0
ATK_URL=https://download.gnome.org/sources/atk/2.38/atk-${ATK_VERSION}.tar.xz
ATK_SHA256=ac4de2a4ef4bd5665052952fe169657e65e895c5057dffb3c2a810f6191a0c36
GTK_VERSION=3.24.52
GTK_URL=https://download.gnome.org/sources/gtk/3.24/gtk-${GTK_VERSION}.tar.xz
GTK_SHA256=80931fa472a77b9a164f6740e3c0b444fac6770054632d35a7ff9d679e5e7b9f
