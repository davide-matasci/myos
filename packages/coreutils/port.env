# uutils coreutils: one multicall ELF aliased under every name in bin/coreutils.
PORT_CORE=0
PORT_DEPS="sysroot"
# build-uutils.sh: the three arches, the manifest and the stamp (build.sh
# is its one-arch worker).
PORT_BUILD=build-uutils.sh
PORT_OUTPUTS="coreutils-manifest-{arch}.txt coreutils-{myos}"
PORT_FILES="multicall:coreutils-{myos}:coreutils-manifest-{arch}.txt:bin/coreutils"
PORT_TEST=test.sh
