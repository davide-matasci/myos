+#[cfg(target_os = "myos")]
+pub struct MyosArgs {
+    idx: usize,
+}
+
+#[cfg(target_os = "myos")]
+impl Iterator for MyosArgs {
+    type Item = OsString;
+
+    fn next(&mut self) -> Option<OsString> {
+        use std::os::myos::ffi::{OsStrExt, OsStringExt};
+        let arg = std::os::myos::args::arg(self.idx)?;
+        self.idx += 1;
+        let mut buf = Vec::with_capacity(arg.len());
+        buf.extend_from_slice(arg.as_bytes());
+        Some(OsStringExt::from_vec(buf))
+    }
+}
