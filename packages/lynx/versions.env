# Pin for Lynx (fetched at build; not vendored).
# Stable 2.9.3 release (2026-05-27) from invisible-island.
LYNX_VERSION=2.9.3
LYNX_TARBALL=lynx${LYNX_VERSION}.tar.gz
# The author's site answers GitHub's runners with 403 now and then (PR
# #747's ports job, 2026-11-04); its mirror serves the same file.
LYNX_URLS="https://invisible-island.net/archives/lynx/tarballs/${LYNX_TARBALL} https://invisible-mirror.net/archives/lynx/tarballs/${LYNX_TARBALL}"
# SHA-256 of the official lynx2.9.3.tar.gz (verified locally 2026-09-07).
LYNX_SHA256=6e99e46980974a6d89eceefbb26ca8c7aa7702b78ecb5bad383b859af225d052
