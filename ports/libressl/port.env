# LibreSSL (libcrypto, libssl and libtls: the TLS of curl, lynx, nginx and
# user/tls, against newlib; of python, against mlibc): build output only,
# nothing in the image.
PORT_CORE=0
PORT_DEPS="mlibc"
PORT_BUILD=build.sh
PORT_OUTPUTS="libressl-{arch} libressl-mlibc-{arch}"
PORT_READY="libressl-{arch}/lib/libssl.a"
PORT_FILES=""
