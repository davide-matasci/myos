--- main.c
+++ main.c
@@ -278,6 +278,12 @@
 		for (wp = environ; *wp != NULL; wp++)
 			typeset(*wp, IMPORT|EXPORT, 0, 0, 0);
 
+	/* Force PATH after environ import (myos bootfs layout). */
+	{
+		struct tbl *vp = global("PATH");
+		setstr(vp, def_path, KSH_RETURN_ERROR);
+	}
+
 	kshpid = procpid = getpid();
 	typeset(initifs, 0, 0, 0, 0);	/* for security */
 
@@ -325,15 +331,12 @@
 
 	ksheuid = geteuid();
 	init_username();
-	safe_prompt = ksheuid ? "$ " : "# ";
+	safe_prompt = "$ ";
 	{
 		struct tbl *vp = global("PS1");
 
-		/* Set PS1 if it isn't set */
-		if (!(vp->flag & ISSET)) {
-			/* setstr can't fail here */
-			setstr(vp, "\\h\\$ ", KSH_RETURN_ERROR);
-		}
+		/* uid 0 would otherwise be `# ` and break interactive CI. */
+		setstr(vp, "$ ", KSH_RETURN_ERROR);
 	}
 
 	/* Set this before parsing arguments */
@@ -388,8 +391,10 @@
 	Flag(FMONITOR) = 0;
 	j_init(i);
 	/* Do this after j_init(), as tty_fd is not initialized 'til then */
-	if (Flag(FTALKING))
-		x_init();
+	if (Flag(FTALKING)) {
+		write(1, "[ OK ] sh\n", 9);	/* CI readiness marker */
+		x_init();	/* emacs line editor on a raw-mode console tty */
+	}
 
 	l = genv->loc;
 	l->argv = make_argv(argc - (argi - 1), &argv[argi - 1]);
@@ -449,7 +454,7 @@
 
 	if (Flag(FTALKING)) {
 		hist_init(s);
-		alarm_init();
+		/* myos: no alarm(2); TMOUT is unused. */
 	} else
 		Flag(FTRACKALL) = 1;	/* set after ENV */
 
@@ -768,7 +773,8 @@
 		if (shf)
 			shf_close(shf);
 		reclaim();
-		exit(exstat);
+		/* myos: skip libc stdio atexit/flush after fork-child unwind. */
+		_exit(exstat);
 	}
 	if (shf)
 		shf_close(shf);
