+		 * program would have.
+		 */
+		for (i = 1; i < NSIG; i++)
+			if (sigtraps[i].set && !sigtraps[i].trap &&
+			    (sigtraps[i].flags & (TF_DFL_INTR|TF_FATAL)))
+				kill(getpid(), i);
 		cleanup_proc_env();
