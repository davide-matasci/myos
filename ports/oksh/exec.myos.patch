--- exec.c
+++ exec.c
@@ -399,6 +399,13 @@
 	return rv;
 }
 
+/* myos: a signal the script set to be ignored (`trap '' SIG`). */
+static int
+sig_user_ignored(Trap *p)
+{
+	return (p->flags & TF_USER_SET) && p->trap != NULL && p->trap[0] == '\0';
+}
+
 /*
  * execute simple command
  */
@@ -680,8 +687,20 @@
 		if (flags&XEXEC) {
 			j_exit();
 			if (!(flags&XBGND) || Flag(FMONITOR)) {
-				setexecsig(&sigtraps[SIGINT], SS_RESTORE_ORIG);
-				setexecsig(&sigtraps[SIGQUIT], SS_RESTORE_ORIG);
+				/* myos: the original disposition is for a signal
+				 * the shell caught for itself; one the script
+				 * ignores (`trap '' INT`, TF_USER_SET with an
+				 * empty trap) stays ignored in the program it
+				 * execs, as POSIX has it (issue #671: `trap ""
+				 * INT; exec sleep 3` died of a SIGINT). settrap
+				 * left it SIG_IGN with nothing to restore.
+				 */
+				if (!sig_user_ignored(&sigtraps[SIGINT]))
+					setexecsig(&sigtraps[SIGINT],
+					    SS_RESTORE_ORIG);
+				if (!sig_user_ignored(&sigtraps[SIGQUIT]))
+					setexecsig(&sigtraps[SIGQUIT],
+					    SS_RESTORE_ORIG);
 			}
 		}
 
