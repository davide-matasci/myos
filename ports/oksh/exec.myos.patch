 		s = t->args[0];
 		ap = makenv();
 		restoresigs();
+		/* myos: a signal the shell dies of by catching it (SIGTERM,
+		 * SIGINT, SIGHUP: trapsig, TF_DFL_INTR or TF_FATAL) that came
+		 * since the fork only set a flag nothing looks at before the
+		 * exec, and was lost: `sleep 300 & kill $!` slept on when the
+		 * kill fell in the child's few milliseconds as a shell. The
