--- exec.c
+++ exec.c
@@ -378,6 +378,25 @@
 		s = t->args[0];
 		ap = makenv();
 		restoresigs();
+		/* myos: a signal the shell dies of by catching it (SIGTERM,
+		 * SIGINT, SIGHUP: trapsig, TF_DFL_INTR or TF_FATAL) that came
+		 * since the fork only set a flag nothing looks at before the
+		 * exec, and was lost: `sleep 300 & kill $!` slept on when the
+		 * kill fell in the child's few milliseconds as a shell. The
+		 * program gets the default disposition (one still at trapsig,
+		 * from a trap of the parent's that cleartraps undid, the exec
+		 * would reset): take it that way now, as the program would
+		 * have. One ignored (SIGINT of a background job) stays so.
+		 */
+		for (i = 1; i < NSIG; i++) {
+			Trap *p = &sigtraps[i];
+
+			if (p->set && !p->trap && p->cursig != SIG_IGN &&
+			    (p->flags & (TF_DFL_INTR|TF_FATAL))) {
+				setsig(p, SIG_DFL, SS_RESTORE_CURR|SS_FORCE);
+				kill(getpid(), i);
+			}
+		}
 		cleanup_proc_env();
 		execve(t->str, t->args, ap);
 		if (errno == ENOEXEC)
