 		}
-		if (Flag(FBGNICE) && (flags & XBGND))
-			nice(4);
+		/* myos: no nice(2). */
 		if ((flags & XBGND) && !Flag(FMONITOR)) {
 			setsig(&sigtraps[SIGINT], SIG_IGN,
 			    SS_RESTORE_IGN|SS_FORCE);
 			setsig(&sigtraps[SIGQUIT], SIG_IGN,
 			    SS_RESTORE_IGN|SS_FORCE);
+			/* myos: ignored for good, as if the job had inherited
+			 * them so (POSIX: an asynchronous list's SIGINT and
+			 * SIGQUIT stay ignored). The exec of the command, by
+			 * comexec with the background flag gone, restores the
+			 * shell's original dispositions (setexecsig,
+			 * SS_RESTORE_ORIG), which undid the two setsig calls
+			 * above when the shell had started with them at the
+			 * default: `sleep 3 & kill -INT $!` ended the sleep.
+			 * With the original now "ignored", every exec in this
+			 * child (a subshell's too, `(cmd; sleep 3) &`) keeps
+			 * SIG_IGN, and a trap of its own cannot take them back,
+			 * as for a signal ignored on entry to the shell.
+			 */
+			sigtraps[SIGINT].flags =
+			    (sigtraps[SIGINT].flags & ~TF_ORIG_DFL) | TF_ORIG_IGN;
+			sigtraps[SIGQUIT].flags =
+			    (sigtraps[SIGQUIT].flags & ~TF_ORIG_DFL) | TF_ORIG_IGN;
 			if (!(flags & (XPIPEI | XCOPROC))) {
