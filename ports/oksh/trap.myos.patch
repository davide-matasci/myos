--- trap.c
+++ trap.c
@@ -12,6 +12,11 @@
 #include "sh.h"
 
 Trap sigtraps[NSIG + 1];
+/* myos: the process each signal was last taken in (trapsig): a forked
+ * child tells a signal it took itself from a trap pending in its parent
+ * at the fork, which is the parent's to run (cleartraps).
+ */
+static pid_t trap_pids[NSIG + 1];
 
 static struct sigaction Sigact_ign, Sigact_trap;
 
@@ -137,6 +137,7 @@
 	int errno_ = errno;
 
 	trap = p->set = 1;
+	trap_pids[i] = getpid();
 	if (p->flags & TF_DFL_INTR)
 		intrsig = 1;
 	if ((p->flags & TF_FATAL) && !p->trap) {
@@ -274,8 +274,9 @@
 {
 	int i;
 	Trap *p;
+	pid_t me = getpid();
 
 	trap = 0;
 	intrsig = 0;
 	fatal_trap = 0;
 	for (i = NSIG+1, p = sigtraps; --i >= 0; p++) {
@@ -280,5 +280,22 @@
 	fatal_trap = 0;
 	for (i = NSIG+1, p = sigtraps; --i >= 0; p++) {
+		/* myos: a signal the shell dies of by catching it (SIGTERM,
+		 * SIGINT, SIGHUP: trapsig, TF_DFL_INTR or TF_FATAL; with a
+		 * trap of the user's too, which the child drops, or without
+		 * one; not one ignored for a background job) that the child
+		 * took since the fork, at its first syscall, is not a pending
+		 * trap to drop: the child dies of it now, as the program it was
+		 * forked for would have (`sleep 3 & kill $!` left the sleep
+		 * alive when the kill came within the child's first
+		 * milliseconds). A trap pending in the parent at the fork is
+		 * the parent's: dropped, as before.
+		 */
+		if (p->set && trap_pids[p->signal] == me && p->cursig != SIG_IGN &&
+		    p->signal > 0 && p->signal < NSIG &&
+		    (p->flags & (TF_DFL_INTR|TF_FATAL))) {
+			setsig(p, SIG_DFL, SS_RESTORE_CURR|SS_FORCE);
+			kill(me, p->signal);
+		}
 		p->set = 0;
 		if ((p->flags & TF_USER_SET) && (p->trap && p->trap[0]))
 			settrap(p, NULL);
