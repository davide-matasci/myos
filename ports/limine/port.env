# limine: Limine's own tool (limine.c from the pinned binary release, which
# carries the BIOS stage), at /bin/etc/limine: `get-myos --install` runs its
# `bios-install` on x86 (docs/install.md), as the host does for the images.
PORT_CORE=1
PORT_BUILD=build.sh
PORT_OUTPUTS="limine-{none}"
PORT_FILES="bin:limine-{none}:bin/etc/limine"
PORT_TEST=test.sh
