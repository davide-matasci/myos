# Dropbear SSH server + client, with the test-only keys (demo OS, not secrets)
# and the /etc/shells dropbear's login check needs.
PORT_CORE=1
PORT_BUILD=build.sh
PORT_OUTPUTS="dropbear-{none} dbclient-{none} dropbearkey-{none}"
PORT_FILES="bin:dropbear-{none}:bin/custom/dropbear bin:dbclient-{none}:bin/custom/dbclient bin:dropbearkey-{none}:bin/custom/dropbearkey file:testkey.pub:.ssh/authorized_keys file:testkey.host:etc/dropbear/ed25519_hostkey file:shells:etc/shells"
PORT_TEST=test.sh
PORT_HOST=host.sh
