# Dropbear SSH server + client and the /etc/shells dropbear's login check
# needs. No key: root's authorized_keys is the owner's to write and the host
# key comes at the first start (dropbear -R). The boot test's public key is
# test data (lib/myos-tests), installed only while the test runs.
PORT_CORE=1
PORT_BUILD=build.sh
PORT_OUTPUTS="dropbear-{none} dbclient-{none} dropbearkey-{none}"
PORT_FILES="bin:dropbear-{none}:bin/custom/dropbear bin:dbclient-{none}:bin/custom/dbclient bin:dropbearkey-{none}:bin/custom/dropbearkey file:testkey.pub:lib/myos-tests/dropbear-testkey.pub file:shells:etc/shells"
PORT_TEST=test.sh
PORT_HOST=host.sh
