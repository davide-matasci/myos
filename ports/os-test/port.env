# sortix os-test: the suite's sources (/lib/os-test, run with make on the
# guest) and the host-prebuilt boot-CI smoke ELFs (/lib/os-test/prebuilt).
PORT_CORE=0
PORT_BUILD=build.sh
PORT_OUTPUTS="os-test-embed os-test-prebuilt"
PORT_READY="os-test-prebuilt/x86_64/basic/arpa_inet/htons"
PORT_FILES="tree:os-test-embed:lib/os-test tree:os-test-prebuilt/{arch}:lib/os-test/prebuilt"
