# Trimmed curl (HTTPS GET) over userspace sockets + mbedtls, with the Mozilla
# CA bundle its build fetches (CURL_CA_BUNDLE=/lib/cacert.pem).
PORT_CORE=1
PORT_BUILD=build.sh
PORT_OUTPUTS="curl-{none} cacert.pem"
PORT_FILES="bin:curl-{none}:bin/etc/curl,bin/custom/curl data:cacert.pem:lib/cacert.pem"
