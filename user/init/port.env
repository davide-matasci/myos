# init: the first process (user/lib), started by the kernel from
# /bin/custom/init in the initramfs. Built by kernel/build.rs for every arch.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=init
PORT_WATCH="../lib/src/lib.rs ../lib/src/alloc.rs ../lib/Cargo.toml"
PORT_FILES="bin:init-{kernel}:bin/custom/init"
