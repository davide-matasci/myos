# The C smoke programs of user/c once more, built against mlibc instead of
# newlib (PORT_LIBC, docs/mlibc.md): the same sources, as /bin/etc/mlibc/*.
# The test runs the smoke tests of user/c/test.sh on them, as mlibc_<name>
# with the mlibc tag: the kernel's interface seen through either libc.
PORT_NAME=c-smokes-mlibc
PORT_KIND=c
PORT_LIBC=mlibc
PORT_DEPS=mlibc
PORT_BUILD=build.sh
PORT_OUTPUTS="c-hello-mlibc-{none} c-socket_smoke-mlibc-{none} tcp-listen-smoke-mlibc-{none} pty-smoke-mlibc-{none} urandom-smoke-mlibc-{none} tty-smoke-mlibc-{none} unix-smoke-mlibc-{none} fb-smoke-mlibc-{none} poll-smoke-mlibc-{none} kbd-smoke-mlibc-{none} mouse-smoke-mlibc-{none} uio-smoke-mlibc-{none} pthread-smoke-mlibc-{none} netconv-smoke-mlibc-{none} loopback-smoke-mlibc-{none} child-smoke-mlibc-{none} libc-smoke-mlibc-{none} sec-mlibc-{none} at-smoke-mlibc-{none} fileio-smoke-mlibc-{none} mmap-smoke-mlibc-{none} bigimage-smoke-mlibc-{none} shm-smoke-mlibc-{none} fault-smoke-mlibc-{none} jit-smoke-mlibc-{none} ctor-smoke-mlibc-{none} sched-smoke-mlibc-{none} memhog-mlibc-{none} evfd-smoke-mlibc-{none} epoll-smoke-mlibc-{none} sigfd-smoke-mlibc-{none} pcidev-smoke-mlibc-{none} tap-smoke-mlibc-{none} multihome-smoke-mlibc-{none} ipv6-smoke-mlibc-{none}"
# All of them the tests', in the tests module (docs/testing.md).
PORT_TEST_FILES="bin:c-hello-mlibc-{none}:bin/etc/mlibc/hello bin:c-socket_smoke-mlibc-{none}:bin/etc/mlibc/socket_smoke bin:tcp-listen-smoke-mlibc-{none}:bin/etc/mlibc/tcp_listen_smoke bin:pty-smoke-mlibc-{none}:bin/etc/mlibc/pty_smoke bin:urandom-smoke-mlibc-{none}:bin/etc/mlibc/urandom_smoke bin:tty-smoke-mlibc-{none}:bin/etc/mlibc/tty_smoke bin:unix-smoke-mlibc-{none}:bin/etc/mlibc/unix_smoke bin:fb-smoke-mlibc-{none}:bin/etc/mlibc/fb_smoke bin:poll-smoke-mlibc-{none}:bin/etc/mlibc/poll_smoke bin:kbd-smoke-mlibc-{none}:bin/etc/mlibc/kbd_smoke bin:mouse-smoke-mlibc-{none}:bin/etc/mlibc/mouse_smoke bin:uio-smoke-mlibc-{none}:bin/etc/mlibc/uio_smoke bin:pthread-smoke-mlibc-{none}:bin/etc/mlibc/pthread_smoke bin:netconv-smoke-mlibc-{none}:bin/etc/mlibc/netconv_smoke bin:loopback-smoke-mlibc-{none}:bin/etc/mlibc/loopback_smoke bin:child-smoke-mlibc-{none}:bin/etc/mlibc/child_smoke bin:libc-smoke-mlibc-{none}:bin/etc/mlibc/libc_smoke bin:sec-mlibc-{none}:bin/etc/mlibc/sec bin:at-smoke-mlibc-{none}:bin/etc/mlibc/at_smoke bin:fileio-smoke-mlibc-{none}:bin/etc/mlibc/fileio_smoke bin:mmap-smoke-mlibc-{none}:bin/etc/mlibc/mmap_smoke bin:bigimage-smoke-mlibc-{none}:bin/etc/mlibc/bigimage_smoke bin:shm-smoke-mlibc-{none}:bin/etc/mlibc/shm_smoke bin:fault-smoke-mlibc-{none}:bin/etc/mlibc/fault_smoke bin:jit-smoke-mlibc-{none}:bin/etc/mlibc/jit_smoke bin:ctor-smoke-mlibc-{none}:bin/etc/mlibc/ctor_smoke bin:sched-smoke-mlibc-{none}:bin/etc/mlibc/sched_smoke bin:memhog-mlibc-{none}:bin/etc/mlibc/memhog bin:evfd-smoke-mlibc-{none}:bin/etc/mlibc/evfd_smoke bin:epoll-smoke-mlibc-{none}:bin/etc/mlibc/epoll_smoke bin:sigfd-smoke-mlibc-{none}:bin/etc/mlibc/sigfd_smoke bin:pcidev-smoke-mlibc-{none}:bin/etc/mlibc/pcidev_smoke bin:tap-smoke-mlibc-{none}:bin/etc/mlibc/tap_smoke bin:multihome-smoke-mlibc-{none}:bin/etc/mlibc/multihome_smoke bin:ipv6-smoke-mlibc-{none}:bin/etc/mlibc/ipv6_smoke"
PORT_TEST=test.sh
