# power: Rust userspace program (user/lib), installed as poweroff, reboot and
# halt. Built by kernel/build.rs for every arch.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=power
PORT_WATCH="../lib/src/lib.rs ../lib/src/alloc.rs ../lib/Cargo.toml"
PORT_FILES="bin:power-{kernel}:bin/custom/poweroff,bin/custom/reboot,bin/custom/halt"
