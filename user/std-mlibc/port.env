# The Rust std on mlibc (the `<arch>-unknown-myos-mlibc` targets,
# docs/userspace.md "Rust userspace"): a program of Rust and C on one C
# library, /bin/std/mlibc/mix, and one whose panics unwind (LLVM's
# libunwind, toolchain/libcxx), /bin/std/mlibc/unwind: the tests'.
PORT_NAME=std-mlibc
PORT_KIND=std
PORT_LIBC=mlibc
PORT_DEPS="sysroot mlibc libcxx"
PORT_BUILD=build.sh
PORT_OUTPUTS="std-mlibc-mix-{myos}-mlibc std-mlibc-unwind-{myos}-mlibc"
PORT_TEST_FILES="bin:std-mlibc-mix-{myos}-mlibc:bin/std/mlibc/mix bin:std-mlibc-unwind-{myos}-mlibc:bin/std/mlibc/unwind"
PORT_TEST=test.sh
