# The Rust std on mlibc (the `<arch>-unknown-myos-mlibc` targets,
# docs/userspace.md "Rust userspace"): a program of Rust and C on one C
# library, /bin/std/mlibc/mix, the test's.
PORT_NAME=std-mlibc
PORT_KIND=std
PORT_LIBC=mlibc
PORT_DEPS="sysroot mlibc"
PORT_BUILD=build.sh
PORT_OUTPUTS="std-mlibc-mix-{myos}-mlibc"
PORT_TEST_FILES="bin:std-mlibc-mix-{myos}-mlibc:bin/std/mlibc/mix"
PORT_TEST=test.sh
