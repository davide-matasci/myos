# The Rust std on mlibc (the `<arch>-unknown-myos-mlibc` targets,
# docs/userspace.md "Rust userspace"): a program of Rust and C on one C
# library, /bin/std/mlibc/mix, and one whose panics unwind (LLVM's
# libunwind, toolchain/libcxx), /bin/std/mlibc/unwind, one that uses what
# a unix std has (/bin/std/mlibc/unix), and one over Rust
# shared objects (dylib/: librt.so, which holds std, and libplugin.so,
# loaded with dlopen), /bin/std/mlibc/dylib: the tests'.
PORT_NAME=std-mlibc
PORT_KIND=std
PORT_LIBC=mlibc
PORT_DEPS="sysroot mlibc libcxx"
PORT_BUILD=build.sh
PORT_OUTPUTS="std-mlibc-mix-{myos}-mlibc std-mlibc-unwind-{myos}-mlibc std-mlibc-unix-{myos}-mlibc std-mlibc-dylib-{myos}-mlibc std-mlibc-dylib-rt-{myos}-mlibc std-mlibc-dylib-plugin-{myos}-mlibc"
PORT_TEST_FILES="bin:std-mlibc-mix-{myos}-mlibc:bin/std/mlibc/mix bin:std-mlibc-unwind-{myos}-mlibc:bin/std/mlibc/unwind bin:std-mlibc-unix-{myos}-mlibc:bin/std/mlibc/unix bin:std-mlibc-dylib-{myos}-mlibc:bin/std/mlibc/dylib bin:std-mlibc-dylib-rt-{myos}-mlibc:bin/std/mlibc/librt.so bin:std-mlibc-dylib-plugin-{myos}-mlibc:bin/std/mlibc/libplugin.so"
PORT_TEST=test.sh
