# netd: Rust userspace program (user/lib). Built by kernel/build.rs for every arch.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=netd
PORT_IMAGE_BASE=1
# smoltcp with myos's patches into target/smoltcp-myos (Cargo.toml's
# [patch.crates-io]) before the build.
PORT_PREPARE=user/net/smoltcp/prepare.sh
PORT_WATCH="../lib/src/lib.rs ../lib/Cargo.toml ../net/src/lib.rs ../net/Cargo.toml ../net/smoltcp/versions.env ../net/smoltcp/arp-gateway.myos.patch"
PORT_FILES="bin:netd-{kernel}:bin/custom/netd"
