# http: Rust userspace program (user/lib). Built by kernel/build.rs for every arch.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=http
PORT_EMBED=custom/http
PORT_IMAGE_BASE=1
PORT_WATCH="../lib/src/lib.rs ../lib/Cargo.toml ../lib/src/dns.rs ../tls/src/lib.rs ../tls/src/platform.c ../tls/Cargo.toml ../tls/build.rs"
PORT_FILES="bin:http-{kernel}:bin/custom/http"
PORT_TEST=test.sh
