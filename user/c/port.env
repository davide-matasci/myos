# The C smoke programs (newlib + libgloss): c-hello (the kernel embeds it) and
# the boot tests' smokes for sockets, TCP listen/accept, AF_UNIX sockets,
# ptys, /dev/urandom, the tty (the shell's line editor and ^C, driven
# through a pty), /dev/fb and poll.
PORT_NAME=c-smokes
PORT_KIND=c
PORT_CORE=1
PORT_BUILD=scripts/build-c-smokes.sh
PORT_OUTPUTS="c-hello-{none} c-socket_smoke-{none} tcp-listen-smoke-{none} pty-smoke-{none} urandom-smoke-{none} tty-smoke-{none} unix-smoke-{none} fb-smoke-{none} poll-smoke-{none}"
PORT_FILES="bin:c-hello-{none}:bin/etc/hello bin:c-socket_smoke-{none}:bin/etc/socket_smoke bin:tcp-listen-smoke-{none}:bin/etc/tcp_listen_smoke bin:pty-smoke-{none}:bin/etc/pty_smoke bin:urandom-smoke-{none}:bin/etc/urandom_smoke bin:tty-smoke-{none}:bin/etc/tty_smoke bin:unix-smoke-{none}:bin/etc/unix_smoke bin:fb-smoke-{none}:bin/etc/fb_smoke bin:poll-smoke-{none}:bin/etc/poll_smoke"
PORT_TEST=test.sh
PORT_HOST=host.sh
