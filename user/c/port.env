# The C smoke programs (newlib + libgloss): c-hello (the kernel embeds it) and
# the boot tests' smokes for sockets, TCP listen/accept, AF_UNIX sockets,
# ptys, /dev/urandom, the tty (the shell's line editor and ^C, driven
# through a pty), /dev/fb, poll, /dev/console/kbd, readv/writev and the
# single-threaded pthread API, and netfs conversations (loopback refused,
# none leaked by sockets closed before netd acked them), the loopback
# interface (UDP and TCP over 127.0.0.1, getifaddrs), kill(pid, 0) and
# children that leave no zombie (SA_NOCLDWAIT, SIGCHLD ignored), and the
# libc functions libgloss gained for the ports' shims (getrandom, vfork,
# daemon, the service lookups), and the *at calls (directory fds and the
# cwd follow their directories), and the constructors and destructors crt0
# runs.
PORT_NAME=c-smokes
PORT_KIND=c
PORT_CORE=1
PORT_BUILD=scripts/build-c-smokes.sh
PORT_OUTPUTS="c-hello-{none} c-socket_smoke-{none} tcp-listen-smoke-{none} pty-smoke-{none} urandom-smoke-{none} tty-smoke-{none} unix-smoke-{none} fb-smoke-{none} poll-smoke-{none} kbd-smoke-{none} uio-smoke-{none} pthread-smoke-{none} netconv-smoke-{none} loopback-smoke-{none} child-smoke-{none} libc-smoke-{none} sec-{none} at-smoke-{none} fileio-smoke-{none} mmap-smoke-{none} shm-smoke-{none} fault-smoke-{none} ctor-smoke-{none} memhog-{none}"
PORT_FILES="bin:c-hello-{none}:bin/etc/hello bin:c-socket_smoke-{none}:bin/etc/socket_smoke bin:tcp-listen-smoke-{none}:bin/etc/tcp_listen_smoke bin:pty-smoke-{none}:bin/etc/pty_smoke bin:urandom-smoke-{none}:bin/etc/urandom_smoke bin:tty-smoke-{none}:bin/etc/tty_smoke bin:unix-smoke-{none}:bin/etc/unix_smoke bin:fb-smoke-{none}:bin/etc/fb_smoke bin:poll-smoke-{none}:bin/etc/poll_smoke bin:kbd-smoke-{none}:bin/etc/kbd_smoke bin:uio-smoke-{none}:bin/etc/uio_smoke bin:pthread-smoke-{none}:bin/etc/pthread_smoke bin:netconv-smoke-{none}:bin/etc/netconv_smoke bin:loopback-smoke-{none}:bin/etc/loopback_smoke bin:child-smoke-{none}:bin/etc/child_smoke bin:libc-smoke-{none}:bin/etc/libc_smoke bin:sec-{none}:bin/etc/sec bin:at-smoke-{none}:bin/etc/at_smoke bin:fileio-smoke-{none}:bin/etc/fileio_smoke bin:mmap-smoke-{none}:bin/etc/mmap_smoke bin:shm-smoke-{none}:bin/etc/shm_smoke bin:fault-smoke-{none}:bin/etc/fault_smoke bin:ctor-smoke-{none}:bin/etc/ctor_smoke bin:memhog-{none}:bin/etc/memhog"
PORT_TEST=test.sh
PORT_HOST=host.sh
