# heap: Rust userspace program (user/lib). Built by kernel/build.rs for every arch.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=heap
PORT_WATCH="../lib/src/lib.rs ../lib/src/alloc.rs ../lib/Cargo.toml"
# A test program: the tests module's (docs/testing.md).
PORT_TEST_FILES="bin:heap-{kernel}:bin/custom/heap"
PORT_TEST=test.sh
