# wifi: the Wi-Fi daemon and its command (user/lib). `wifi daemon` drives a
# radio (the AX201 through /dev/pci and the iwx crate, or the simulated
# one of the test boots: /dev/net1, src/wifi_sim.rs);
# `wifi scan` / `wifi list` ask it over the unix socket `wifid`
# (docs/wifi.md). Linked at USER_BASE: ET_EXEC with absolute vtables.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=wifi
PORT_IMAGE_BASE=1
PORT_WATCH="../lib/src/lib.rs ../lib/src/alloc.rs ../lib/Cargo.toml iwx/src iwx/Cargo.toml"
PORT_FILES="bin:wifi-{kernel}:bin/custom/wifi file:wifi-firmware:bin/custom/wifi-firmware"
PORT_TEST=test.sh
