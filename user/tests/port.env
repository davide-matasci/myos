# The boot tests (docs/testing.md): the runner and the core test sections,
# in every image under /lib/myos-tests; the ports' own tests (PORT_TEST)
# join them under /lib/myos-tests/ports/. Nothing to build.
PORT_NAME=tests
PORT_CORE=1
PORT_BUILD=
PORT_OUTPUTS=""
PORT_FILES="file:run.sh:lib/myos-tests/run.sh file:shell.sh:lib/myos-tests/shell.sh file:linux.sh:lib/myos-tests/linux.sh file:net.sh:lib/myos-tests/net.sh"
