# The boot tests (docs/testing.md): the runner and the kernel's own tests,
# in every image under /lib/myos-tests; the ports' tests (PORT_TEST) join
# them under /lib/myos-tests/ports/. Nothing to build.
PORT_NAME=tests
PORT_CORE=1
PORT_BUILD=
PORT_OUTPUTS=""
PORT_FILES="file:run.sh:lib/myos-tests/run.sh file:kernel.sh:lib/myos-tests/kernel.sh"
PORT_HOST=host.sh
