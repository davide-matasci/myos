# get-myos: installs packages (packages/<name>, built by CI and published,
# not in the image) from a mirror; docs/packages.md. Core: the way to get
# what the image does not carry. Linked with the zlib port.
PORT_CORE=1
PORT_DEPS="zlib"
PORT_BUILD=build.sh
PORT_OUTPUTS="get-myos-{none}"
PORT_FILES="bin:get-myos-{none}:bin/etc/get-myos"
PORT_TEST=test.sh
