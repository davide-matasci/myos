#!/bin/sh
# run-myos [-r ROOT] APP[@VERSION][,APP...][:CMD] [ARGS...]
#
# Run an app get-myos installed (docs/packages.md): ROOT/APP/ (a symlink
# to the current version, ROOT/APP-VERSION/) holds the files the port
# would have in the image (bin/custom/vim, lib/vim/vimrc) and its
# manifest, `app`:
#
#   run /bin/custom/vim        what `run-myos APP` starts (none: a library)
#   needs x11-xft x11-fonts    the apps it uses, theirs included
#
# The command runs in a namespace of its own (`sec ns`, docs/security.md):
# the whole system as the caller sees it, and the files of APP and of what
# it needs at the paths they were built for, the shallowest path the
# system lacks bound to the app's (/lib/vim to ROOT/vim/lib/vim; a file
# into a directory the system has, /bin/custom/vim, alone). Nothing changes
# for any other process, and nothing is left behind when it exits.
#
# APP:CMD runs another command of the view's apps, the named ones first
# (coreutils:ls), or, as an absolute path, anything in the view
# (os-test:/bin/sh SCRIPT). Several apps, comma separated, share one view
# (tinyx,dwm:startx, a session; git,coreutils:/bin/custom/heap), the
# command without CMD the first one's. APP@VERSION runs another installed
# version than the current one (VERSION: the start of its hash, `get-myos
# -l`), what it needs at their current ones. ROOT is -r, else what
# `get-myos --root` says.

usage() {
	echo "usage: run-myos [-r ROOT] APP[@VERSION][,APP...][:CMD] [ARGS...]" >&2
	exit 2
}

root=
if [ "${1-}" = -r ]; then
	[ $# -ge 2 ] || usage
	root=$2
	shift 2
fi
[ $# -ge 1 ] || usage
[ -n "$root" ] || root=$(get-myos --root) || exit 1
spec=$1
shift
named=${spec%%:*}
cmd=
case $spec in *:*) cmd=${spec#*:} ;; esac

# The value of `key` in the manifest of the app in directory $1.
manifest() {
	sed -n "s/^$2[ 	][ 	]*//p" "$1/app" | head -n 1
}

# The directory of app $1: the version ROOT/APP points at (resolved now, so
# that an upgrade meanwhile does not mix two), or for APP@VERSION the one
# installed version whose hash starts with VERSION.
appdir() {
	case $1 in
	*@*)
		v=${1#*@}
		case $v in "" | *[!0-9a-f]*) echo "run-myos: bad version in $1" >&2; return 1 ;; esac
		d=
		for e in "$root/${1%%@*}-$v"*/; do
			[ -d "$e" ] || continue
			[ -z "$d" ] || { echo "run-myos: $1 names more than one version" >&2; return 1; }
			d=${e%/}
		done
		[ -n "$d" ] || { echo "run-myos: no version $v of ${1%%@*} in $root (get-myos -l)" >&2; return 1; }
		echo "$d"
		;;
	*)
		l=$(readlink "$root/$1" 2> /dev/null)
		case $l in
		"") echo "$root/$1" ;;
		/*) echo "$l" ;;
		*) echo "$root/$l" ;;
		esac
		;;
	esac
}

# The apps named and, transitively, what they need, one version each (a
# named one's): their names and their directories.
apps=
dirs=
todo=$(echo "$named" | tr , ' ')
while [ -n "$todo" ]; do
	a=${todo%% *}
	todo=${todo#"$a"}
	todo=${todo# }
	case " $apps " in *" ${a%%@*} "*) continue ;; esac
	dir=$(appdir "$a") || exit 1
	if [ ! -f "$dir/app" ]; then
		echo "run-myos: ${a%%@*} is not installed in $root (get-myos ${a%%@*})" >&2
		exit 1
	fi
	apps="$apps ${a%%@*}"
	dirs="$dirs $dir"
	todo="$todo $(manifest "$dir" needs)"
	todo=${todo# }
done

# What to run.
case $cmd in
"")
	app=${apps# }
	app=${app%% *}
	dir=${dirs# }
	path=$(manifest "${dir%% *}" run)
	[ -n "$path" ] || { echo "run-myos: $app has no command of its own: run-myos $app:CMD" >&2; exit 1; }
	;;
/*)
	path=$cmd
	;;
*)
	path=
	for dir in $dirs; do
		for d in "$dir"/bin/*/; do
			[ -e "$d$cmd" ] && path=/bin/${d#"$dir/bin/"}$cmd && break 2
		done
	done
	[ -n "$path" ] || { echo "run-myos: no command $cmd in$apps" >&2; exit 1; }
	;;
esac

# The bindings: each app's tree walked from its top, a path the system
# lacks bound whole, a directory it has entered; the manifest and the
# app's own tests (lib/myos-tests) are not part of its view.
binds=
for dir in $dirs; do
	queue=/
	while [ -n "$queue" ]; do
		d=${queue%% *}
		queue=${queue#"$d"}
		queue=${queue# }
		for e in $(ls -A "$dir$d"); do
			rel=${d%/}/$e
			case $rel in /app | /lib/myos-tests) continue ;; esac
			if [ -e "$rel" ] && [ -d "$dir$rel" ] && [ ! -L "$dir$rel" ]; then
				queue="$queue $rel"
			else
				binds="$binds $rel=$dir$rel"
			fi
		done
		queue=${queue# }
	done
done

exec sec ns / $binds -- "$path" "$@"
