# The Rust std demo programs (hello, cat, echo, bigalloc, sleep) on the myos
# std sysroot; the kernel embeds them too.
PORT_NAME=std-hello
PORT_KIND=std
PORT_CORE=1
PORT_DEPS="sysroot"
PORT_BUILD=build.sh
PORT_OUTPUTS="std-hello-{myos} std-cat-{myos} std-echo-{myos} std-bigalloc-{myos} std-sleep-{myos}"
PORT_FILES="bin:std-hello-{myos}:bin/std/hello bin:std-cat-{myos}:bin/std/cat bin:std-echo-{myos}:bin/std/echo bin:std-bigalloc-{myos}:bin/std/bigalloc bin:std-sleep-{myos}:bin/std/sleep"
PORT_TEST=test.sh
