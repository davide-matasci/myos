# mkfs.ext2: Rust userspace program (user/lib). Built by kernel/build.rs for every arch.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=mkfs_ext2
PORT_WATCH="../lib/src/lib.rs ../lib/src/alloc.rs ../lib/Cargo.toml ../../modules/ext2/ext2fs/src"
PORT_FILES="bin:mkfs_ext2-{kernel}:bin/custom/mkfs.ext2"
PORT_TEST=test.sh
