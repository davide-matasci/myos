#!/bin/sh
# ps: the processes in /proc (docs/proc.md), one row each, by pid.
#   -e  the kernel's own processes too (idle, kernel threads)
#   -L  a row per thread
# A process that exits while ps reads it is left out. The rows go to one
# printf (it repeats its format), so ps runs two programs, not one a row.

usage() {
	echo 'usage: ps [-eL]' >&2
	exit 1
}

all=0
threads=0
while getopts eL o; do
	case $o in
	e) all=1 ;;
	L) threads=1 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

if [ $threads = 1 ]; then
	echo '  PID   TID STATE   CPU     TIME NAME'
	fmt='%5d %5d %-7s %3s %5d:%02d %s\n'
else
	echo '  PID  PPID STATE   THR  SIZE(K)     TIME NAME'
	fmt='%5d %5d %-7s %3d %8d %5d:%02d %s\n'
fi

set --
for d in /proc/[0-9]*; do
	read -r pid name state ppid pgid sid nthreads size cpu children start kind \
		2>/dev/null < "$d/status" || continue
	[ $all = 1 ] || [ "$kind" = user ] || continue
	if [ $threads = 0 ]; then
		set -- "$@" $pid $ppid $state $nthreads $size \
			$((cpu / 60000)) $((cpu / 1000 % 60)) $name
		continue
	fi
	for t in "$d"/task/*; do
		read -r tid tpid tname tstate home wait time rest \
			2>/dev/null < "$t/status" || continue
		set -- "$@" $pid $tid $tstate $home \
			$((time / 60000)) $((time / 1000 % 60)) $tname
	done
done
[ $# -eq 0 ] || printf "$fmt" "$@" | sort -n -k1,1 -k2,2
