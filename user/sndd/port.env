# sndd: the sound server (user/lib), started at boot by init. It owns
# /dev/sound's streams (the sound core's, docs/sound.md) and mixes the
# programs that play through the unix socket `sndd` (`play`, user/c).
# Linked at USER_BASE: ET_EXEC with absolute vtables.
PORT_KIND=user
PORT_CORE=1
PORT_BIN=sndd
PORT_IMAGE_BASE=1
PORT_WATCH="../lib/src/lib.rs ../lib/src/alloc.rs ../lib/Cargo.toml"
PORT_FILES="bin:sndd-{kernel}:bin/custom/sndd"
PORT_TEST=test.sh
