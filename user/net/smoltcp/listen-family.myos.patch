+    /// myos: a socket bound to no address hears the IP version
+    /// `set_ip_version` names, either without one.
+    #[test]
+    #[cfg(all(feature = "proto-ipv4", feature = "proto-ipv6", feature = "medium-ip"))]
+    fn test_ip_version() {
+        let (mut iface, _, _) = setup(Medium::Ip);
+        let cx = iface.context();
+        let mut socket = socket(buffer(1), buffer(0));
+        assert_eq!(socket.bind(LOCAL_PORT), Ok(()));
+        assert!(socket.accepts(cx, &REMOTE_IP_REPR, &REMOTE_UDP_REPR));
+        socket.set_ip_version(Some(REMOTE_IP_REPR.version()));
+        assert!(socket.accepts(cx, &REMOTE_IP_REPR, &REMOTE_UDP_REPR));
+        let other = match REMOTE_IP_REPR.version() {
+            IpVersion::Ipv4 => IpVersion::Ipv6,
+            IpVersion::Ipv6 => IpVersion::Ipv4,
+        };
+        socket.set_ip_version(Some(other));
+        assert!(!socket.accepts(cx, &REMOTE_IP_REPR, &REMOTE_UDP_REPR));
