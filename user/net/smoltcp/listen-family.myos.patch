+    /// myos: a listener on no address takes the connections of the IP
+    /// version `set_listen_version` names, of either without one.
+    #[test]
+    #[cfg(all(feature = "proto-ipv4", feature = "proto-ipv6"))]
+    fn test_listen_version() {
+        let mut s = socket_listen();
+        let tcp_repr = TcpRepr {
+            control: TcpControl::Syn,
+            seq_number: REMOTE_SEQ,
+            ack_number: None,
+            ..SEND_TEMPL
+        };
+        assert!(s.socket.accepts(&mut s.cx, &SEND_IP_TEMPL, &tcp_repr));
+        s.socket.set_listen_version(Some(SEND_IP_TEMPL.version()));
+        assert!(s.socket.accepts(&mut s.cx, &SEND_IP_TEMPL, &tcp_repr));
+        let other = match SEND_IP_TEMPL.version() {
+            IpVersion::Ipv4 => IpVersion::Ipv6,
+            IpVersion::Ipv6 => IpVersion::Ipv4,
+        };
+        s.socket.set_listen_version(Some(other));
+        assert!(!s.socket.accepts(&mut s.cx, &SEND_IP_TEMPL, &tcp_repr));
+    }
+
