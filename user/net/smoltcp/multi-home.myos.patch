+    /// myos: one of several NICs sharing a socket set: it sends only the
+    /// packets whose source address is one of its own (or unspecified: a
+    /// DHCP request), so a connection leaves through the link its address
+    /// belongs to; another NIC's packet waits in its socket for that NIC,
+    /// as with [`set_local_elsewhere`].
+    ///
+    /// [`set_local_elsewhere`]: Self::set_local_elsewhere
+    pub fn set_own_source_only(&mut self, own_source_only: bool) {
+        self.inner.own_source_only = own_source_only;
+    }
+
+    /// myos: the addresses of the other NICs of the socket set (up to
+    /// [`ELSEWHERE_MAX`]), which, as this one's own with
+    /// [`set_local_elsewhere`], the loopback interface delivers.
+    ///
+    /// [`set_local_elsewhere`]: Self::set_local_elsewhere
+    pub fn set_elsewhere_addrs(&mut self, addrs: &[IpAddress]) {
+        self.inner.elsewhere = [None; ELSEWHERE_MAX];
+        for (slot, a) in self.inner.elsewhere.iter_mut().zip(addrs) {
+            *slot = Some(*a);
+        }
+    }
