+    /// myos: tie the socket to the NIC with hardware address `owner`, one
+    /// of several sharing a socket set: only that NIC sends its requests
+    /// and hands it the replies (a reply names the NIC it is for).
+    pub fn set_owner(&mut self, owner: Option<HardwareAddress>) {
+        self.owner = owner;
+    }
+
+    /// myos: whether the NIC with hardware address `addr` drives this socket.
+    pub(crate) fn owned_by(&self, addr: HardwareAddress) -> bool {
+        self.owner.is_none_or(|o| o == addr)
+    }
