+/// myos: a loopback interface beside a NIC's, sharing the sockets
+/// (`set_local_only`, `set_local_elsewhere`): local destinations leave
+/// through the loopback interface only, the rest through the NIC's only,
+/// and a datagram waits in its socket for the interface that routes it.
+#[test]
+#[cfg(all(feature = "medium-ip", feature = "socket-udp"))]
+fn test_local_only_pair() {
+    use crate::socket::udp;
+    use crate::tests::TestingDevice;
+    use crate::wire::IpEndpoint;
+
+    let own = Ipv4Address::new(192, 168, 1, 1);
+    let mut nic_dev = TestingDevice::new(Medium::Ip);
+    let mut nic = Interface::new(Config::new(HardwareAddress::Ip), &mut nic_dev, Instant::ZERO);
+    nic.update_ip_addrs(|a| a.push(IpCidr::new(own.into(), 24)).unwrap());
+    nic.routes_mut()
+        .add_default_ipv4_route(Ipv4Address::new(192, 168, 1, 254))
+        .unwrap();
+    nic.set_local_elsewhere(true);
+    let mut lo_dev = TestingDevice::new(Medium::Ip);
+    let mut lo = Interface::new(Config::new(HardwareAddress::Ip), &mut lo_dev, Instant::ZERO);
+    lo.update_ip_addrs(|a| {
+        a.push(IpCidr::new(IpAddress::v4(127, 0, 0, 1), 8)).unwrap();
+        a.push(IpCidr::new(own.into(), 32)).unwrap();
+    });
+    lo.set_local_only(true);
+
+    let mut sockets = SocketSet::new(vec![]);
+    let rx = udp::PacketBuffer::new(vec![udp::PacketMetadata::EMPTY; 4], vec![0; 64]);
+    let tx = udp::PacketBuffer::new(vec![udp::PacketMetadata::EMPTY; 4], vec![0; 64]);
+    let h = sockets.add(udp::Socket::new(rx, tx));
+    let s = sockets.get_mut::<udp::Socket>(h);
+    s.bind(1234).unwrap();
+    for dst in [
+        Ipv4Address::new(127, 0, 0, 1),
+        own,
+        Ipv4Address::new(10, 0, 0, 1),
+    ] {
+        s.send_slice(b"x", IpEndpoint::new(dst.into(), 53)).unwrap();
+    }
+
+    // The first datagram is local: the NIC's interface leaves it queued.
+    nic.poll(Instant::ZERO, &mut nic_dev, &mut sockets);
+    assert!(nic_dev.tx_queue.is_empty());
+    // The loopback interface takes both local ones (one per poll), then
+    // leaves the last one queued.
+    for _ in 0..3 {
+        lo.poll_egress(Instant::ZERO, &mut lo_dev, &mut sockets);
+    }
+    assert_eq!(lo_dev.tx_queue.len(), 2);
+    // And the NIC's the last one, not silenced by its earlier miss.
+    nic.poll(Instant::ZERO, &mut nic_dev, &mut sockets);
+    assert_eq!(nic_dev.tx_queue.len(), 1);
+}
+
+/// myos: a loopback interface (`set_local_only`) leaves the DHCP sockets
+/// it shares with a NIC's alone: it has no hardware address to ask with.
+#[test]
+#[cfg(all(feature = "medium-ip", feature = "socket-dhcpv4"))]
+fn test_local_only_leaves_dhcp() {
+    use crate::tests::TestingDevice;
+
+    let mut dev = TestingDevice::new(Medium::Ip);
+    let mut lo = Interface::new(Config::new(HardwareAddress::Ip), &mut dev, Instant::ZERO);
+    lo.update_ip_addrs(|a| a.push(IpCidr::new(IpAddress::v4(127, 0, 0, 1), 8)).unwrap());
+    lo.set_local_only(true);
+    let mut sockets = SocketSet::new(vec![]);
+    sockets.add(crate::socket::dhcpv4::Socket::new());
+    lo.poll(Instant::ZERO, &mut dev, &mut sockets);
+    assert!(dev.tx_queue.is_empty());
+}
