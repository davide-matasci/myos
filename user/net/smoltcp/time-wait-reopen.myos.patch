-        // slot a listener on the port has (myos).
+        // slot a listener on the port has (myos). A SYN reopening a
+        // connection in TIME-WAIT ends that one and goes on to a listener,
+        // where the new connection starts above the old one's sequence
+        // numbers (myos, `reopened_from_time_wait`).
+        let mut reopened = None;
         for listeners in [false, true] {
             for tcp_socket in sockets
                 .items_mut()
@@ -29,9 +33,15 @@ impl InterfaceInner {
                 if (tcp_socket.state() == State::Listen) == listeners
                     && tcp_socket.accepts(self, &ip_repr, &tcp_repr)
                 {
-                    return tcp_socket
-                        .process(self, &ip_repr, &tcp_repr)
-                        .map(|(ip, tcp)| Packet::new(ip, IpPayload::Tcp(tcp)));
+                    if tcp_socket.reopened_from_time_wait(&tcp_repr) {
+                        reopened = Some(tcp_socket.end_time_wait());
+                        continue;
+                    }
+                    let reply = tcp_socket.process(self, &ip_repr, &tcp_repr);
+                    if let Some(last) = reopened {
+                        tcp_socket.sequence_above(last);
+                    }
