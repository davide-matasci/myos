+
+/// myos: a SYN to a connection in TIME-WAIT, from the same peer port and
+/// after what the peer sent on it, opens a new connection in its place
+/// (RFC 1122 4.2.2.13, as Linux does): the TIME-WAIT ends, a listener takes
+/// the SYN, and the new connection's sequence numbers start above the old
+/// one's. An old duplicate SYN (from before) is still dropped. Linux hands
+/// a loopback port out again within seconds; dropped for the 10 s of the
+/// TIME-WAIT, the SYN came again on the peer's timer or never (a listen
+/// test's connection lost, issue #656).
+#[test]
+#[cfg(all(feature = "medium-ip", feature = "socket-tcp"))]
+fn test_tcp_syn_reopens_time_wait() {
+    use crate::socket::tcp;
+
+    let (mut iface, mut sockets, mut device) = setup(Medium::Ip);
+    let new_socket = || {
+        tcp::Socket::new(
+            tcp::SocketBuffer::new(vec![0; 64]),
+            tcp::SocketBuffer::new(vec![0; 64]),
+        )
+    };
+    let peer = Ipv4Address::new(192, 168, 1, 2);
+    let own = Ipv4Address::new(192, 168, 1, 1);
+    let segment = |control, seq: i32, ack: Option<i32>| {
+        let repr = TcpRepr {
+            src_port: 4242,
+            dst_port: 80,
+            control,
+            seq_number: TcpSeqNumber(seq),
+            ack_number: ack.map(TcpSeqNumber),
+            window_len: 256,
+            window_scale: None,
+            max_seg_size: None,
+            sack_permitted: false,
+            sack_ranges: [None, None, None],
+            timestamp: None,
+            payload: &[],
+        };
+        let mut bytes = vec![0u8; repr.buffer_len()];
+        repr.emit(
+            &mut TcpPacket::new_unchecked(&mut bytes),
+            &peer.into(),
+            &own.into(),
+            &ChecksumCapabilities::default(),
+        );
+        let ip = IpRepr::Ipv4(Ipv4Repr {
+            src_addr: peer,
+            dst_addr: own,
+            next_header: IpProtocol::Tcp,
+            payload_len: repr.buffer_len(),
+            hop_limit: 64,
+        });
+        (ip, bytes)
+    };
+    let state = |sockets: &SocketSet<'_>, h| sockets.get::<tcp::Socket>(h).state();
+
+    // A connection, closed by this side first (the peer's SYN, its ACK of
+    // the SYN-ACK, this side's close, the peer's ACK of the FIN with its own
+    // FIN): this side waits in TIME-WAIT. The test ISN is 10000, so the
+    // peer's ACKs are 10001 and, after the FIN, 10002.
+    let conn = sockets.add(new_socket());
+    sockets.get_mut::<tcp::Socket>(conn).listen(80).unwrap();
+    let (ip, bytes) = segment(TcpControl::Syn, 1000, None);
+    iface.inner.process_tcp(&mut sockets, ip, &bytes);
+    let (ip, bytes) = segment(TcpControl::None, 1001, Some(10001));
+    iface.inner.process_tcp(&mut sockets, ip, &bytes);
+    assert_eq!(state(&sockets, conn), tcp::State::Established);
+    sockets.get_mut::<tcp::Socket>(conn).close();
+    let (ip, bytes) = segment(TcpControl::Fin, 1001, Some(10002));
+    iface.inner.process_tcp(&mut sockets, ip, &bytes);
+    assert_eq!(state(&sockets, conn), tcp::State::TimeWait);
+    device.tx_queue.clear();
+
+    // A listener on the port again, in a later slot; a SYN from before what
+    // the peer sent (an old duplicate) is dropped.
+    let fresh = sockets.add(new_socket());
+    sockets.get_mut::<tcp::Socket>(fresh).listen(80).unwrap();
+    let (ip, bytes) = segment(TcpControl::Syn, 900, None);
+    assert_eq!(iface.inner.process_tcp(&mut sockets, ip, &bytes), None);
+    assert_eq!(state(&sockets, conn), tcp::State::TimeWait);
+    assert_eq!(state(&sockets, fresh), tcp::State::Listen);
+
+    // A SYN from after it reopens: the TIME-WAIT ends, the listener takes
+    // the SYN, and its SYN-ACK starts above the old connection's 10002.
+    let (ip, bytes) = segment(TcpControl::Syn, 5000, None);
+    assert_eq!(iface.inner.process_tcp(&mut sockets, ip, &bytes), None);
+    assert_eq!(state(&sockets, conn), tcp::State::Closed);
+    assert_eq!(state(&sockets, fresh), tcp::State::SynReceived);
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    let frame = device.tx_queue.pop_front().expect("the SYN-ACK");
+    let packet = Ipv4Packet::new_checked(&frame[..]).unwrap();
+    let syn_ack = TcpPacket::new_checked(packet.payload()).unwrap();
+    assert!(syn_ack.syn() && syn_ack.ack());
+    assert_eq!(syn_ack.ack_number(), TcpSeqNumber(5001));
+    assert!(syn_ack.seq_number() > TcpSeqNumber(10002 + 65535));
+}
diff --git a/src/socket/tcp.rs b/src/socket/tcp.rs
--- a/src/socket/tcp.rs
+++ b/src/socket/tcp.rs
@@ -1487,6 +1487,39 @@ impl<'a> Socket<'a> {
         }
     }
 
+    /// myos: whether `repr`, which this socket accepts, is a SYN reopening the
+    /// connection from TIME-WAIT: the peer has the port again (Linux hands a
+    /// loopback port out again within seconds) and starts after what it sent
+    /// on the old connection, so it is no old duplicate. RFC 1122 4.2.2.13
+    /// allows the new connection, and Linux opens it; the interface then ends
+    /// this socket's TIME-WAIT and gives the SYN to a listener. Dropped, as
+    /// before, the SYN came again only on the peer's timer (QEMU's after 6 s,
+    /// then 18 s), or never.
+    pub(crate) fn reopened_from_time_wait(&self, repr: &TcpRepr) -> bool {
+        self.state == State::TimeWait
+            && repr.control == TcpControl::Syn
+            && repr.ack_number.is_none()
+            && repr.seq_number > self.remote_seq_no + self.rx_buffer.len()
+    }
+
+    /// myos: end the TIME-WAIT for a reopening SYN: the last sequence number
+    /// this connection sent, which the new connection's must start above.
+    pub(crate) fn end_time_wait(&mut self) -> TcpSeqNumber {
+        let last = self.local_seq_no;
+        self.reset();
+        last
+    }
+
+    /// myos: this connection just opened in a TIME-WAIT's place: its sequence
+    /// numbers start above the old connection's `last`, as Linux's do, so the
+    /// peer takes no late segment of the old connection for one of this one.
+    pub(crate) fn sequence_above(&mut self, last: TcpSeqNumber) {
+        if self.state == State::SynReceived {
+            self.local_seq_no = last + 65535 + 2;
+            self.remote_last_seq = self.local_seq_no;
+        }
+    }
+
     pub(crate) fn process(
         &mut self,
         cx: &mut Context,
